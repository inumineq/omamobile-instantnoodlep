#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""Fail on anchors.*Margin next to Quickshell's boolean window anchors.

A PanelWindow's `anchors` group only has the four booleans; its margins live
in `margins { ... }`. `anchors.leftMargin:` there makes the whole QML file fail
to load ("Cannot assign to non-existent property"), which removed the launcher,
dock and home strip on 2026-11-18. The package's own check() does not load QML,
so this lint is the guard. Usage: lint-panelwindow-margins <dir-or-qml>...
"""
import pathlib, re, sys

BOOL_ANCHORS = re.compile(r'^(\s*)anchors\s*\{[^}]*:\s*(true|false)')
MARGIN = re.compile(r'^(\s*)anchors\.(top|bottom|left|right)Margin\s*:')

def files(args):
    for a in args:
        p = pathlib.Path(a)
        yield from (sorted(p.rglob('*.qml')) if p.is_dir() else [p])

bad = 0
for f in files(sys.argv[1:]):
    window_indent = None
    for n, line in enumerate(f.read_text().splitlines(), 1):
        if (m := BOOL_ANCHORS.match(line)):
            window_indent = m.group(1)
            continue
        if window_indent is not None and line.strip() and not line.startswith(window_indent):
            window_indent = None
        m = MARGIN.match(line)
        if m and window_indent is not None and m.group(1) == window_indent:
            print(f'{f}:{n}: anchors.{m.group(2)}Margin on a window with boolean anchors; '
                  f'use margins {{ {m.group(2)}: ... }}')
            bad += 1
sys.exit(1 if bad else 0)
