# SPDX-License-Identifier: MIT
# kernel-slim-waydroid.config: Waydroid (Android in an LXC container) delta
# on slim K3.
#
# Merged on top of ~/android/build/k3-slim/.config (branch
# instantnoodlep-k3-slim-waydroid in ~/src/l-k3-slim) with
# scripts/kconfig/merge_config.sh -m + olddefconfig, built with
# O=~/android/build/k3-slim-waydroid. See WAYDROID-PLAN.md for the plan and
# the owner-gated RAM-first runbook. kernel-slim.config itself is NOT edited
# (the daily-kernel line owns it); this file is the feature fragment in the
# PR #108 pattern: slim base + fragment, built as a RAM-boot candidate.
#
# Size rule: only =y symbols grow the arm64 header image_size that ABL
# checks (ceiling 0x2b60000, slim boots at 0x1720000; KERNEL-SIZE.md), so
# the headroom is about 0x1440000 (20 MiB). Binder is bool in 7.3-rc6
# (drivers/android/Kconfig: ANDROID_BINDER_IPC/ANDROID_BINDERFS are bool,
# depend on MMU && NET), so binder/binderfs MUST be =y here and cost a
# little Image; every other Waydroid symbol below is =m and stays out of the
# Image. Measure the merged Image before any RAM boot; hard stop above
# 0x2b60000, prefer 0x2560000 or below (KERNEL-SIZE.md).
#
# ashmem: the ASHMEM symbol does not exist anywhere in the 7.3-rc6 tree
# (grep over Kconfig*/Makefile), it was removed from mainline; Android 13
# uses memfd when /dev/ashmem is missing (upstream WAYDROID-PLAN §1 table),
# so MEMFD_CREATE=y is the ashmem replacement and no /dev/ashmem node is
# created.

# --- Identify the build ---
# uname -r must differ from slim and daily so a RAM boot is unambiguous.
CONFIG_LOCALVERSION="-instantnoodlep-k3-slim-waydroid"

# --- Binder IPC + binderfs (bool in this tree: built in, not a module) ---
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
# CONFIG_ANDROID_BINDER_IPC_RUST is not set
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"

# --- ashmem replacement and lmkd pressure ---
# lmkd needs /proc/pressure/memory; without PSI it exits and Android's init
# reboots the container (upstream WAYDROID-PLAN §1).
CONFIG_MEMFD_CREATE=y
CONFIG_PSI=y
# CONFIG_PSI_DEFAULT_DISABLED is not set

# --- Config readable from userspace (omamobile-waydroid check, W0/W2) ---
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# --- Sync files for Android's HWC (SW_SYNC is left off on purpose) ---
CONFIG_SYNC_FILE=y

# --- Container prerequisites (modules; pinned so the base cannot drop them) ---
CONFIG_BRIDGE=m
CONFIG_VETH=m
CONFIG_TUN=m
CONFIG_OVERLAY_FS=m
CONFIG_FUSE_FS=m

# --- Android's netd inside the container (upstream WAYDROID-PLAN W1 block) ---
# netd and its iptables binary use the legacy setsockopt interface, not
# nf_tables, and route each network through its own table with fwmark
# rules; without these Android gets an address but no route and the boot
# loops. Built in: the routing options (they change struct net) and the
# legacy xtables core. Everything else is a module that autoloads on use.
# The host side (ufw, waydroid-net.sh) stays on nf_tables only; never run
# iptables-legacy on the host.
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_IPV6_ROUTER_PREF=y
CONFIG_IPV6_ROUTE_INFO=y
CONFIG_IPV6_OPTIMISTIC_DAD=y
CONFIG_INET_UDP_DIAG=y
CONFIG_INET_DIAG_DESTROY=y
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES_LEGACY=m
CONFIG_IP_NF_FILTER=m
CONFIG_IP_NF_MANGLE=m
CONFIG_IP_NF_RAW=m
CONFIG_IP_NF_NAT=m
CONFIG_IP_NF_TARGET_MASQUERADE=m
CONFIG_IP_NF_TARGET_NETMAP=m
CONFIG_IP_NF_TARGET_REDIRECT=m
CONFIG_IP_NF_MATCH_AH=m
CONFIG_IP_NF_MATCH_ECN=m
CONFIG_IP_NF_MATCH_TTL=m
CONFIG_IP6_NF_IPTABLES_LEGACY=m
CONFIG_IP6_NF_FILTER=m
CONFIG_IP6_NF_MANGLE=m
CONFIG_IP6_NF_RAW=m
CONFIG_IP6_NF_MATCH_IPV6HEADER=m
CONFIG_IP6_NF_MATCH_RPFILTER=m
# The matches and targets Android's netd and its firewall chains use
# (Android's kernel/configs "android-base" set, minus the out-of-tree
# quota2; netd falls back to xt_quota for its alert rules).
CONFIG_NF_CONNTRACK_MARK=y
CONFIG_NETFILTER_NETLINK_LOG=m
CONFIG_NETFILTER_NETLINK_QUEUE=m
CONFIG_NETFILTER_XT_MARK=m
CONFIG_NETFILTER_XT_CONNMARK=m
CONFIG_NETFILTER_XT_NAT=m
CONFIG_NETFILTER_XT_MATCH_BPF=m
CONFIG_NETFILTER_XT_MATCH_CONNLIMIT=m
CONFIG_NETFILTER_XT_MATCH_ECN=m
CONFIG_NETFILTER_XT_MATCH_HASHLIMIT=m
CONFIG_NETFILTER_XT_MATCH_HELPER=m
CONFIG_NETFILTER_XT_MATCH_IPRANGE=m
CONFIG_NETFILTER_XT_MATCH_LENGTH=m
CONFIG_NETFILTER_XT_MATCH_MAC=m
CONFIG_NETFILTER_XT_MATCH_PKTTYPE=m
CONFIG_NETFILTER_XT_MATCH_QUOTA=m
CONFIG_NETFILTER_XT_MATCH_SOCKET=m
CONFIG_NETFILTER_XT_MATCH_STATISTIC=m
CONFIG_NETFILTER_XT_MATCH_STRING=m
CONFIG_NETFILTER_XT_MATCH_TIME=m
CONFIG_NETFILTER_XT_MATCH_U32=m
CONFIG_NETFILTER_XT_TARGET_CHECKSUM=m
CONFIG_NETFILTER_XT_TARGET_CLASSIFY=m
CONFIG_NETFILTER_XT_TARGET_CT=m
CONFIG_NETFILTER_XT_TARGET_IDLETIMER=m
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=m
CONFIG_NETFILTER_XT_TARGET_NETMAP=m
CONFIG_NETFILTER_XT_TARGET_NFLOG=m
CONFIG_NETFILTER_XT_TARGET_NFQUEUE=m
CONFIG_NETFILTER_XT_TARGET_REDIRECT=m
CONFIG_NETFILTER_XT_TARGET_TCPMSS=m
CONFIG_NETFILTER_XT_TARGET_TPROXY=m
# Traffic accounting through BPF classifiers (netd's bandwidth
# controller). NET_CLS_BPF/NET_ACT_BPF sit inside `if NET_SCHED`
# (net/sched/Kconfig:44-966), and kernel-slim.config turns NET_SCHED off,
# so this candidate re-enables the bool gate; the classifiers themselves
# stay modules. Small built-in cost, measured in the merged Image.
CONFIG_NET_SCHED=y
CONFIG_NET_CLS_ACT=y
CONFIG_NET_CLS_BPF=m
CONFIG_NET_ACT_BPF=m

# --- Left off on purpose (upstream WAYDROID-PLAN §1.1) ---
# SW_SYNC (Waydroid binds /dev/sw_sync only if it exists; the HWC uses real
# sync files from the GPU, SYNC_FILE=y above), UHID, USERFAULTFD,
# CGROUP_NS, Rust binder, ASHMEM (gone from mainline, see header).
# CONFIG_SW_SYNC is not set
# CONFIG_UHID is not set
# CONFIG_USERFAULTFD is not set
