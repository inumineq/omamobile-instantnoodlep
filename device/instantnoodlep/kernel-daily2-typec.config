# SPDX-License-Identifier: MIT
# Type-C step 1 for daily2: PM8150B TCPM, QMP orientation, no DP altmode.
CONFIG_LOCALVERSION="-instantnoodlep-k3-daily2-qce-gmu-typec"
# Keep the release string stable despite uncommitted preparation changes.
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_TYPEC_TCPM=y
CONFIG_TYPEC_QCOM_PMIC=y
CONFIG_TYPEC_MUX_FSA4480=y
# Type-C step 1 has no DP altmode declaration or driver.
# CONFIG_TYPEC_DP_ALTMODE is not set
# USB host is needed for a keyboard or dock; keep this candidate dual-role.
CONFIG_USB_XHCI_HCD=y
# Deliberately omitted: CONFIG_TYPEC_DP_ALTMODE.
