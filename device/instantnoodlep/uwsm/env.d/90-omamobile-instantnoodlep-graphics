# OnePlus 8 Pro (instantnoodlep, SM8250, Adreno 650): the session's GL
# choice, sourced by uwsm from /usr/share/uwsm/env.d (POSIX shell; a user's
# ~/.config/uwsm/env and env-hyprland run after it and may override).
# Modelled on omamobile-tegu-graphics and 90-omamobile-bluejay-graphics.
#
# Hardware GL (freedreno) when the render node belongs to the msm DRM driver
# and Mesa ships the msm loader entry (msm_dri.so, freedreno). Otherwise
# llvmpipe, so a phone whose GPU did not come up (missing zap or SQE
# firmware, Mesa without freedreno) still gets a desktop.
#
# The msm render node's sysfs device is the MDSS platform device (driver
# "msm-mdss" or "msm_mdss" depending on kernel) or, with msm's
# separate_gpu_kms, the GPU itself ("adreno"); "msm" covers older kernels.
noodle_gpu=
if [ -c /dev/dri/renderD128 ] && [ -e /usr/lib/dri/msm_dri.so ]; then
  noodle_drv=$(readlink /sys/class/drm/renderD128/device/driver 2>/dev/null)
  case "${noodle_drv##*/}" in
    msm | msm-mdss | msm_mdss | msm_dpu | adreno) noodle_gpu=1 ;;
  esac
  unset noodle_drv
fi
if [ -n "$noodle_gpu" ]; then
  export LIBGL_ALWAYS_SOFTWARE=0
  unset GALLIUM_DRIVER QT_QUICK_BACKEND
  export QSG_RHI_BACKEND=opengl
else
  export LIBGL_ALWAYS_SOFTWARE=1
  export GALLIUM_DRIVER=llvmpipe
  export QT_QUICK_BACKEND=software
  unset QSG_RHI_BACKEND
fi
unset noodle_gpu
