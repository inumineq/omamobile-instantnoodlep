# Started by 80-omamobile-bt-addr.rules for the QCA6390 Bluetooth controller.
# A service rather than a udev RUN, because udev's sandbox has no Bluetooth
# sockets.
[Unit]
Description=Set the public Bluetooth address of %i
Before=bluetooth.service

[Service]
Type=oneshot
ExecStart=/usr/bin/omamobile-bt-addr %i
