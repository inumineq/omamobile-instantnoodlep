# SPDX-License-Identifier: MIT
# instantnoodlep's probe fragment, merged after kernel/configs/omamobile.config
# (BRINGUP-M1-PLAN.md 5.5-5.6, kernel K1).
#
# Same rule as device/dipper/kernel.config upstream: everything the RAM probe
# needs to reach USB networking and read-only UFS is built in, not a module.
# Devices probe once, early; a PHY or glue driver that only turns up later as a
# module leaves dwc3 and ufshcd deferred forever, and the bring-up initramfs
# loads no modules for them. arm64 defconfig makes most of the SM8250 pieces
# below modules, so each one is pinned here.
#
# Size: this ABL's kernel limit is not measured yet (dipper's was 0xF80000
# bytes for kernel+dtb). Anything first light does not need stays a module.

# Identify the build in uname -r and the boot record.
CONFIG_LOCALVERSION="-instantnoodlep-k3"

# --- USB peripheral (NCM + ACM gadget from omamobile.config) ------------------
# dwc3 is built in by omamobile.config; the Qualcomm glue defaults to =m.
CONFIG_USB_DWC3_QCOM=y
# usb_1_hsphy ("qcom,sm8250-usb-hs-phy") is the Synopsys femto v2 PHY.
CONFIG_PHY_QCOM_USB_SNPS_FEMTO_V2=y
# usb_1_qmpphy ("qcom,sm8250-qmp-usb3-dp-phy"): the USB3/DP combo PHY.
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_COMBO=y
# The probe DTB forces dr_mode = "peripheral"; the PMIC Type-C port is still
# built in so a later DT with the role switch does not stall in probe.
CONFIG_TYPEC=y
CONFIG_TYPEC_QCOM_PMIC=y

# --- UFS storage (read-only in M1a; the init allows no writes) ---------------
# ufshcd core is built in; the SM8250 glue and its QMP PHY default to =m.
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_QMP_UFS=y

# --- Watchdog -----------------------------------------------------------------
# APSS watchdog (sm8250.dtsi). Built in, so the kernel claims and pings it from
# probe even if the initramfs feeder never starts. The dipper-style init patch
# (`modprobe qcom_wdt || echo ...`) tolerates a built-in driver.
CONFIG_WATCHDOG=y
CONFIG_QCOM_WDT=y
CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED=y

# --- Console and early-hang evidence -----------------------------------------
# simple-framebuffer at 0x9c000000 (C/ chosen/framebuffer0): built in by
# omamobile.config through SYSFB_SIMPLEFB + DRM_SIMPLEDRM; keep fbcon on it.
CONFIG_FRAMEBUFFER_CONSOLE=y
# The DTS reserves ramoops at 0xb0000000; defconfig makes PSTORE_RAM a module,
# which would load too late to catch an early hang.
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y

# --- PMIC keys and reboot ----------------------------------------------------
# pon_pwrkey/pon_resin and reboot modes; the initramfs may read keys early.
CONFIG_POWER_RESET_QCOM_PON=y
CONFIG_INPUT_PM8941_PWRKEY=y

# --- Init and initramfs (pinned; omamobile.config sets most of these) --------
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# --- Display and touch (K3, DISPLAY-M3-PLAN) ---------------------------------
# Built in: the rootfs module set is tied to one kernel release, and the
# panel must come up without modules. K3 with DRM_MSM=y is 16.1 MB Image.gz
# and RAM-boots on this ABL (NOTES 2026-11-17), so dipper's size limit does
# not bite here.
CONFIG_DRM_MSM=y
CONFIG_DRM_PANEL_SAMSUNG_AMS678UW01=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_DRM_DISPLAY_HELPER=y
CONFIG_QCOM_LLCC=y
CONFIG_QCOM_OCMEM=y
CONFIG_QCOM_MDT_LOADER=y
# msm_dsi defers forever on the 'refgen' supply when this is a module.
CONFIG_REGULATOR_QCOM_REFGEN=y
# qcom-cpufreq-hw defers on its icc paths without the OSM L3 provider.
CONFIG_INTERCONNECT_QCOM_OSM_L3=y
# Touch: s6sy761 on i2c13 (qupv3_id_1, gpi_dma1).
CONFIG_TOUCHSCREEN_S6SY761=y
CONFIG_I2C_QCOM_GENI=y
CONFIG_QCOM_GPI_DMA=y

# --- Left as modules on purpose -----------------------------------------------
# Remote processors stay off in the probe DTB and out of the kernel image.
CONFIG_QCOM_Q6V5_PAS=m
CONFIG_QCOM_SYSMON=m

# --- Wi-Fi and Bluetooth (QCA6390, WIFI-BT-M5-PLAN) --------------------------
# Not boot-critical: all modules, loaded by udev from the rootfs once the PMU,
# wifi@0 and bluetooth DT nodes appear. arm64 defconfig already sets these;
# pinned so a defconfig change cannot drop them. PCIE_QCOM stays built in
# (defconfig) and defers until the PHY module loads.
# PCIe0 PHY and the QCA6390 power sequencer (pwrseq-qcom-wcn) with its PCI
# power-control client (pci-pwrctrl-pwrseq binds pci17cb,1101).
CONFIG_PHY_QCOM_QMP_PCIE=m
CONFIG_POWER_SEQUENCING=y
CONFIG_POWER_SEQUENCING_QCOM_WCN=m
CONFIG_PCI_PWRCTRL_PWRSEQ=m
# ath11k on PCIe: QMI over QRTR on MHI (in-kernel name service, no
# userspace qrtr or pd-mapper needed).
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_MHI_BUS=m
CONFIG_QRTR=m
CONFIG_QRTR_MHI=m
CONFIG_ATH11K=m
CONFIG_ATH11K_PCI=m
# Bluetooth on UART6 through serdev and hci_qca (no hciattach).
CONFIG_SERIAL_QCOM_GENI=y
CONFIG_SERIAL_DEV_BUS=y
CONFIG_BT=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_SERDEV=y
CONFIG_BT_HCIUART_QCA=y
CONFIG_BT_QCA=m

# --- External flashless SDX55 (MODEM-M5-DELTA, offline candidate) ------------
# Transport built in; this later section overrides the Wi-Fi module defaults.
# Owner wiring/private-state gates must pass before any RAM boot.
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCIE_QCOM=y
CONFIG_PHY_QCOM_QMP_PCIE=y
CONFIG_ARM_SMMU=y
CONFIG_ARM_SMMU_QCOM=y
CONFIG_ARM_GIC_V3=y
# GICv3 builds irq-gic-v3-mbi.o directly; no separate MBI Kconfig symbol.
CONFIG_MHI_BUS=y
CONFIG_MHI_BUS_PCI_GENERIC=y
# Only exists with patches/instantnoodlep/kernel-modem/0002; without it
# Kconfig drops the line silently, which is a failed gate (delta section 3).
CONFIG_MHI_BUS_SAHARA=y
# GNSS=m caps WWAN at =m; LOC uses QRTR, so no GNSS tty core is needed.
# CONFIG_GNSS is not set
CONFIG_WWAN=y
CONFIG_MHI_WWAN_CTRL=y
CONFIG_MHI_NET=y
CONFIG_QRTR=y
CONFIG_QRTR_MHI=y
