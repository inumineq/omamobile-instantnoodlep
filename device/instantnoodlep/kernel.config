# SPDX-License-Identifier: MIT
# instantnoodlep's probe fragment, merged after kernel/configs/omamobile.config
# (BRINGUP-M1-PLAN.md 5.5-5.6, kernel K1).
#
# Same rule as device/dipper/kernel.config upstream: everything the RAM probe
# needs to reach USB networking and read-only UFS is built in, not a module.
# Devices probe once, early; a PHY or glue driver that only turns up later as a
# module leaves dwc3 and ufshcd deferred forever, and the bring-up initramfs
# loads no modules for them. arm64 defconfig makes most of the SM8250 pieces
# below modules, so each one is pinned here.
#
# Size: this ABL's kernel limit is not measured yet (dipper's was 0xF80000
# bytes for kernel+dtb). Anything first light does not need stays a module.

# Identify the build in uname -r and the boot record.
CONFIG_LOCALVERSION="-instantnoodlep-k1"

# --- USB peripheral (NCM + ACM gadget from omamobile.config) ------------------
# dwc3 is built in by omamobile.config; the Qualcomm glue defaults to =m.
CONFIG_USB_DWC3_QCOM=y
# usb_1_hsphy ("qcom,sm8250-usb-hs-phy") is the Synopsys femto v2 PHY.
CONFIG_PHY_QCOM_USB_SNPS_FEMTO_V2=y
# usb_1_qmpphy ("qcom,sm8250-qmp-usb3-dp-phy"): the USB3/DP combo PHY.
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_COMBO=y
# The probe DTB forces dr_mode = "peripheral"; the PMIC Type-C port is still
# built in so a later DT with the role switch does not stall in probe.
CONFIG_TYPEC=y
CONFIG_TYPEC_QCOM_PMIC=y

# --- UFS storage (read-only in M1a; the init allows no writes) ---------------
# ufshcd core is built in; the SM8250 glue and its QMP PHY default to =m.
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_QMP_UFS=y

# --- Watchdog -----------------------------------------------------------------
# APSS watchdog (sm8250.dtsi). Built in, so the kernel claims and pings it from
# probe even if the initramfs feeder never starts. The dipper-style init patch
# (`modprobe qcom_wdt || echo ...`) tolerates a built-in driver.
CONFIG_WATCHDOG=y
CONFIG_QCOM_WDT=y
CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED=y

# --- Console and early-hang evidence -----------------------------------------
# simple-framebuffer at 0x9c000000 (C/ chosen/framebuffer0): built in by
# omamobile.config through SYSFB_SIMPLEFB + DRM_SIMPLEDRM; keep fbcon on it.
CONFIG_FRAMEBUFFER_CONSOLE=y
# The DTS reserves ramoops at 0xb0000000; defconfig makes PSTORE_RAM a module,
# which would load too late to catch an early hang.
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y

# --- PMIC keys and reboot ----------------------------------------------------
# pon_pwrkey/pon_resin and reboot modes; the initramfs may read keys early.
CONFIG_POWER_RESET_QCOM_PON=y
CONFIG_INPUT_PM8941_PWRKEY=y

# --- Init and initramfs (pinned; omamobile.config sets most of these) --------
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# --- Left as modules on purpose -----------------------------------------------
# Display comes from the bootloader framebuffer, not the MSM driver (dipper:
# DRM_MSM=y pushed the kernel past its ABL limit).
CONFIG_DRM_MSM=m
# Remote processors stay off in the probe DTB and out of the kernel image.
CONFIG_QCOM_Q6V5_PAS=m
CONFIG_QCOM_SYSMON=m
