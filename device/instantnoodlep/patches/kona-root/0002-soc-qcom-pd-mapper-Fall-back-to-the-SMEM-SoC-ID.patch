From 65140a843d98bc90c8ea70f826bfeb5252f46ee1 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Mikkel=20Inumineq=20J=C3=B8rgensen?=
 <6770514+inumineq@users.noreply.github.com>
Date: Tue, 17 Nov 2026 12:59:47 +0100
Subject: [PATCH 2/3] soc: qcom: pd-mapper: Fall back to the SMEM SoC ID

The protection domain tables are selected by matching the root
compatible against a table of SoC compatibles. On the OnePlus 8 Pro
(SM8250) the stock ABL applies a vendor overlay from the dtbo partition
on every boot, which replaces the root compatible with "qcom,kona-mtp",
"qcom,kona", "qcom,mtp". The lookup then fails, the in-kernel PD mapper
does not start, and the audio, sensor and modem DSPs are left without a
service locator.

The protection domain layout is a property of the SoC, and the SoC ID is
available from SMEM. When the root compatible matches nothing, look the
SoC ID up in a second table. Start it with SM8250; other SoCs can be
added when a board needs it. Defer if SMEM has not probed yet; an
unknown SoC ID keeps failing with -ENODEV as before.

The driver now calls into SMEM, so make it depend on QCOM_SMEM. Every
remoteproc driver that instantiates the PD mapper already does.

Platforms whose root compatible matches keep their current behaviour.

Assisted-by: Claude Opus 5.5
---
 drivers/soc/qcom/Kconfig          |  1 +
 drivers/soc/qcom/qcom_pd_mapper.c | 47 ++++++++++++++++++++++++++++---
 2 files changed, 44 insertions(+), 4 deletions(-)

diff --git a/drivers/soc/qcom/Kconfig b/drivers/soc/qcom/Kconfig
index 2b524154d..746ce1df3 100644
--- a/drivers/soc/qcom/Kconfig
+++ b/drivers/soc/qcom/Kconfig
@@ -83,6 +83,7 @@ config QCOM_PD_MAPPER
 	select QCOM_PDR_MSG
 	select AUXILIARY_BUS
 	depends on NET && QRTR
+	depends on QCOM_SMEM
 	default QCOM_RPROC_COMMON
 	help
 	  The Protection Domain Mapper maps registered services to the domains
diff --git a/drivers/soc/qcom/qcom_pd_mapper.c b/drivers/soc/qcom/qcom_pd_mapper.c
index 64ca99d7f..1a92f6930 100644
--- a/drivers/soc/qcom/qcom_pd_mapper.c
+++ b/drivers/soc/qcom/qcom_pd_mapper.c
@@ -12,6 +12,9 @@
 #include <linux/refcount.h>
 #include <linux/slab.h>
 #include <linux/soc/qcom/qmi.h>
+#include <linux/soc/qcom/smem.h>
+
+#include <dt-bindings/arm/qcom,ids.h>
 
 #include "pdr_internal.h"
 
@@ -668,6 +671,37 @@ static const struct of_device_id qcom_pdm_domains[] __maybe_unused = {
 	{},
 };
 
+/*
+ * Some bootloaders rewrite the root compatible of the DT they pass on, so
+ * that the SoC compatible is missing from it. The OnePlus 8 Pro ABL, for
+ * one, applies a vendor overlay that replaces it with "qcom,kona".
+ * Fall back to the SoC ID that the boot chain stores in SMEM.
+ */
+static const struct {
+	u32 soc_id;
+	const struct qcom_pdm_domain_data * const *domains;
+} qcom_pdm_soc_ids[] = {
+	{ QCOM_ID_SM8250, sm8250_domains },
+};
+
+static const struct qcom_pdm_domain_data * const *qcom_pdm_match_soc_id(void)
+{
+	u32 soc_id;
+	int ret, i;
+
+	ret = qcom_smem_get_soc_id(&soc_id);
+	if (ret == -EPROBE_DEFER)
+		return ERR_PTR(ret);
+	if (ret)
+		return ERR_PTR(-ENODEV);
+
+	for (i = 0; i < ARRAY_SIZE(qcom_pdm_soc_ids); i++)
+		if (qcom_pdm_soc_ids[i].soc_id == soc_id)
+			return qcom_pdm_soc_ids[i].domains;
+
+	return ERR_PTR(-ENODEV);
+}
+
 static void qcom_pdm_stop(struct qcom_pdm_data *data)
 {
 	qcom_pdm_free_domains(data);
@@ -686,12 +720,17 @@ static struct qcom_pdm_data *qcom_pdm_start(void)
 	int ret, i;
 
 	match = of_machine_get_match(qcom_pdm_domains);
-	if (!match) {
-		pr_notice("PDM: no support for the platform, userspace daemon might be required.\n");
-		return ERR_PTR(-ENODEV);
+	if (match) {
+		domains = match->data;
+	} else {
+		domains = qcom_pdm_match_soc_id();
+		if (IS_ERR(domains)) {
+			if (PTR_ERR(domains) != -EPROBE_DEFER)
+				pr_notice("PDM: no support for the platform, userspace daemon might be required.\n");
+			return ERR_CAST(domains);
+		}
 	}
 
-	domains = match->data;
 	if (!domains) {
 		pr_debug("PDM: no domains\n");
 		return ERR_PTR(-ENODEV);
-- 
