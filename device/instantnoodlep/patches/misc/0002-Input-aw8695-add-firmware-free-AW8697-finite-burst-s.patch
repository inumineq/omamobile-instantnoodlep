+#define AW8695_NUM_F0_1 0x7d
+#define AW8695_NUM_F0_1_PRE_MASK GENMASK(7, 4)
+#define AW8695_NUM_F0_1_WAIT_MASK GENMASK(3, 0)
+
+/* Number Configuration for F0 Trace #2 */
+#define AW8695_NUM_F0_2 0x7e
+
