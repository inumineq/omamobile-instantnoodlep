From c5b2f4028f85d0cf2d7e48e58ead882efe53dc5b Mon Sep 17 00:00:00 2001
From: Mikkel Inumineq <hello@mikkeljorgensen.dk>
Date: Tue, 17 Nov 2026 13:55:15 +0100
Subject: [PATCH 1/4] dt-bindings: modem: describe the flashless SDX55 PCI
 endpoint

The soldered SDX55 on this board has no boot flash, and it shares its PCI
and subsystem IDs with Foxconn modules that do have one. Describe the
absence of local flash so the host knows it has to supply the bootloader
images and expose the Sahara channels.

The distinction is board-specific: the public instantnoodlep reference
(Timo/darknagel, 65b22ce9f236, patch 17) selects its profile this way
because the PCI ID alone cannot tell the two apart.

Assisted-by: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../bindings/modem/qcom,sdx55-mhi.yaml        | 46 +++++++++++++++++++
 MAINTAINERS                                   |  1 +
 2 files changed, 47 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/modem/qcom,sdx55-mhi.yaml

diff --git a/Documentation/devicetree/bindings/modem/qcom,sdx55-mhi.yaml b/Documentation/devicetree/bindings/modem/qcom,sdx55-mhi.yaml
new file mode 100644
index 000000000..894777092
--- /dev/null
+++ b/Documentation/devicetree/bindings/modem/qcom,sdx55-mhi.yaml
@@ -0,0 +1,46 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/modem/qcom,sdx55-mhi.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Qualcomm SDX55 modem on PCIe
+
+maintainers:
+  - Manivannan Sadhasivam <mani@kernel.org>
+
+description: |
+  SDX55 uses MHI over PCIe. A soldered flashless part can share PCI and
+  subsystem IDs with a module containing flash. Describe the absence of
+  flash so the host can supply the bootloader and expose Sahara channels.
+
+properties:
+  compatible:
+    const: pci17cb,306
+
+  reg:
+    maxItems: 1
+
+  qcom,flashless:
+    type: boolean
+    description:
+      The modem has no local boot flash and needs host-provided images.
+
+required:
+  - compatible
+  - reg
+
+additionalProperties: false
+
+examples:
+  - |
+    pcie {
+        #address-cells = <3>;
+        #size-cells = <2>;
+
+        modem@0,0 {
+            compatible = "pci17cb,306";
+            reg = <0x10000 0 0 0 0>;
+            qcom,flashless;
+        };
+    };
diff --git a/MAINTAINERS b/MAINTAINERS
index a44d4a1fb..cf909dcb6 100644
--- a/MAINTAINERS
+++ b/MAINTAINERS
@@ -17695,6 +17695,7 @@ L:	linux-arm-msm@vger.kernel.org
 S:	Maintained
 T:	git git://git.kernel.org/pub/scm/linux/kernel/git/mani/mhi.git
 F:	Documentation/ABI/stable/sysfs-bus-mhi
+F:	Documentation/devicetree/bindings/modem/qcom,sdx55-mhi.yaml
 F:	Documentation/mhi/
 F:	drivers/bus/mhi/
 F:	drivers/pci/endpoint/functions/pci-epf-mhi.c
