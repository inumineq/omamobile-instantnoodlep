+	.num_events = ARRAY_SIZE(modem_qcom_v1_mhi_events),
+	.event_cfg = modem_qcom_v1_mhi_events,
+};
+
+static const struct mhi_pci_dev_info mhi_sdx55_flashless_info = {
+	.name = "qcom-sdx55m-flashless",
+	.fw = "qcom/sdx55m/sbl1.mbn",
+	.config = &mhi_sdx55_flashless_config,
+	.bar_num = MHI_PCI_DEFAULT_BAR_NUM,
+	.dma_data_width = 32,
+	.mru_default = 32768,
+};
+
 static const struct mhi_pci_dev_info mhi_qcom_sdx35_info = {
 	.name = "qcom-sdx35m",
 	.config = &modem_qcom_v2_mhiv_config,
@@ -1371,6 +1412,11 @@ static int mhi_pci_probe(struct pci_dev *pdev, const struct pci_device_id *id)
 	unsigned int dma_data_width;
 	int err;
 
+	/* The soldered flashless part shares a subsystem ID with Foxconn. */
