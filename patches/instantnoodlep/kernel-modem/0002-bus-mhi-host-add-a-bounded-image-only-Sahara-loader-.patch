From d1a51b5862cef7f37a243e54df3524135e94a2ad Mon Sep 17 00:00:00 2001
From: Mikkel Inumineq <hello@mikkeljorgensen.dk>
Date: Tue, 17 Nov 2026 13:55:27 +0100
Subject: [PATCH 2/4] bus: mhi: host: add a bounded image-only Sahara loader
 for flashless SDX55

A flashless SDX55 boots from images the host serves over the SBL SAHARA
channels, so the host needs a Sahara server before MHI can come up. Add
one that serves only this board's non-private firmware, with bounded
commands, image size, served bytes and synchronous TX batch waits.

Requests for EFS, per-unit DDR training state, memory dumps and runtime
sync are refused and end the session. The loader never resets the
endpoint to retry, never reads modem memory and never persists state, and
it exposes no Firehose channel or EDL loader.

Image IDs, channel layout and batching follow the public instantnoodlep
reference (Timo/darknagel, 65b22ce9f236, patches 16, 20-22 and 31); the
Sahara packet semantics are documented by the GPL-2.0-only qaic driver.

Assisted-by: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/bus/mhi/host/Kconfig       |   9 +
 drivers/bus/mhi/host/Makefile      |   3 +
 drivers/bus/mhi/host/pci_generic.c |  46 ++++
 drivers/bus/mhi/host/sahara.c      | 341 +++++++++++++++++++++++++++++
 4 files changed, 399 insertions(+)
 create mode 100644 drivers/bus/mhi/host/sahara.c

diff --git a/drivers/bus/mhi/host/Kconfig b/drivers/bus/mhi/host/Kconfig
index da5cd0c9f..7d124f163 100644
--- a/drivers/bus/mhi/host/Kconfig
+++ b/drivers/bus/mhi/host/Kconfig
@@ -21,6 +21,15 @@ config MHI_BUS_DEBUG
 	  reading and/or modifying some values within the MHI controller
 	  for debug and test purposes.
 
+config MHI_BUS_SAHARA
+	tristate "Bounded Sahara image loader for flashless SDX55"
+	depends on MHI_BUS
+	help
+	  Serve allowlisted firmware images over the SBL SAHARA channel of a
+	  flashless SDX55. Private EFS/DDR state, memory dumps and state sync
+	  are deliberately unsupported. A request for these stops the loader.
+	  No modem partition access or persistent state storage is provided.
+
 config MHI_BUS_PCI_GENERIC
 	tristate "MHI PCI controller driver"
 	depends on MHI_BUS
diff --git a/drivers/bus/mhi/host/Makefile b/drivers/bus/mhi/host/Makefile
index 859c2f384..d28740984 100644
--- a/drivers/bus/mhi/host/Makefile
+++ b/drivers/bus/mhi/host/Makefile
@@ -4,3 +4,6 @@ mhi-$(CONFIG_MHI_BUS_DEBUG) += debugfs.o
 
 obj-$(CONFIG_MHI_BUS_PCI_GENERIC) += mhi_pci_generic.o
 mhi_pci_generic-y += pci_generic.o
+
+obj-$(CONFIG_MHI_BUS_SAHARA) += mhi_sahara.o
+mhi_sahara-y := sahara.o
