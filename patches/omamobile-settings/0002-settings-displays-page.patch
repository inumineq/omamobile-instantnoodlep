+#!/bin/bash
+# SPDX-License-Identifier: MIT
+set -euo pipefail
+source_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
+tmp=$(mktemp -d)
+trap 'rm -rf -- "$tmp"' EXIT
+fixture="$tmp/monitors.json"
+calls="$tmp/calls"
+fake="$tmp/hyprctl"
+backend="$tmp/displays.sh"
+home="$tmp/home"
+mkdir -p "$home/.config/hypr"
+printf 'hl.config({ general = { layout = "dwindle" } })\n' >"$home/.config/hypr/monitors.lua"
+cat >"$fixture" <<'JSON'
+[
+  {"name":"DSI-1","width":1440,"height":3168,"x":0,"y":0,"scale":3,"refreshRate":120,"availableModes":["1440x3168@120.00Hz","1440x3168@60.00Hz"]},
+  {"name":"DP-1","description":"Dell U3219Q","width":3840,"height":2160,"x":1440,"y":0,"scale":1,"refreshRate":60,"availableModes":["3840x2160@60.00Hz","2560x1440@60.00Hz","1920x1080@60.00Hz"]}
+]
+JSON
+cat >"$fake" <<'FAKE'
+#!/bin/bash
+set -euo pipefail
+if [[ $1 == -j && $2 == monitors && $3 == all ]]; then
+  /usr/bin/cat "$OMAMOBILE_SETTINGS_MONITORS_FIXTURE"
+elif [[ $1 == eval ]]; then
+  /usr/bin/printf '%s\n' "$2" >>"$OMAMOBILE_SETTINGS_HYPRCTL_CALLS"
+  /usr/bin/printf 'ok\n'
+else
+  exit 2
+fi
+FAKE
+chmod 700 "$fake"
+sed "s|HYPRCTL = \"/usr/bin/hyprctl\"|HYPRCTL = \"$fake\"|" \
+  "$source_dir/backends/displays.sh" >"$backend"
+run() {
+  HOME="$home" OMAMOBILE_SETTINGS_MONITORS_FIXTURE="$fixture" \
+    OMAMOBILE_SETTINGS_HYPRCTL_CALLS="$calls" /usr/bin/bash "$backend" "$@"
+}
+result=$(run get)
+python3 -c 'import json,sys; d=json.loads(sys.argv[1]); assert [m["name"] for m in d["monitors"]] == ["DSI-1","DP-1"]; assert d["monitors"][0]["internal"] is True; assert d["monitors"][0]["availableModes"] == ["1440x3168@120", "1440x3168@60"]; assert d["monitors"][0]["currentMode"] == "1440x3168@120"; assert d["monitors"][1]["availableModes"] == ["3840x2160@60", "2560x1440@60", "1920x1080@60"]; assert d["monitors"][1]["currentMode"] == "3840x2160@60"' "$result"
+echo 'ok - connected displays include current mode and U3219Q modes; DSI-1 is read-only'
+if run set DSI-1 1440x3168@60 2 >/dev/null 2>&1; then
+  echo 'not ok - built-in panel can be changed' >&2; exit 1
+fi
+if run set DP-1 1280x720@60 1 >/dev/null 2>&1; then
+  echo 'not ok - unavailable mode can be selected' >&2; exit 1
+fi
+echo 'ok - internal panel and unavailable modes are rejected'
+run set DP-1 2560x1440@60 1.5 >/dev/null
+grep -Fq 'hl.monitor({ output = "DP-1", mode = "2560x1440@60", position = "auto", scale = 1.5 })' "$home/.config/hypr/monitors.lua"
+grep -Fq 'hl.config({ general = { layout = "dwindle" } })' "$home/.config/hypr/monitors.lua"
+grep -Fq '"2560x1440@60"' "$calls"
+echo 'ok - selected mode is applied through Lua eval and persisted for login'
+run set DP-1 1920x1080@60 2 >/dev/null
+[[ $(/usr/bin/grep -c '^-- omamobile-display:' "$home/.config/hypr/monitors.lua") == 1 ]]
+grep -Fq 'mode = "1920x1080@60", position = "auto", scale = 2' "$home/.config/hypr/monitors.lua"
+echo 'ok - changing a monitor updates its saved rule without replacing user config'
