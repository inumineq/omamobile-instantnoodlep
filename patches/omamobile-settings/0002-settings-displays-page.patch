diff --git a/backends/displays.sh b/backends/displays.sh
new file mode 100644
--- /dev/null
+++ b/backends/displays.sh
@@ -0,0 +1,238 @@
+#!/bin/bash
+# SPDX-License-Identifier: MIT
+# List Hyprland outputs and apply/persist a mode and scale for external outputs.
+set -euo pipefail
+set +x
+exec /usr/bin/python3 -I - "$@" <<'PY'
+import json
+import os
+import pathlib
+import re
+import stat
+import subprocess
+import sys
+import tempfile
+
+HYPRCTL = "/usr/bin/hyprctl"
+START = "-- BEGIN omamobile-settings displays"
+END = "-- END omamobile-settings displays"
+NAME_RE = re.compile(r"[A-Za-z0-9_.-]{1,32}\Z")
+MODE_RE = re.compile(r"([0-9]{3,5})x([0-9]{3,5})@([0-9]{1,3}(?:\.[0-9]{1,3})?)(?:Hz)?\Z")
+SCALES = {"1", "1.25", "1.5", "1.75", "2", "2.25", "2.5", "2.75", "3"}
+
+
+def fail(message):
+    print(json.dumps({"error": message}, separators=(",", ":")))
+    raise SystemExit(2)
+
+
+def canonical_mode(value):
+    match = MODE_RE.fullmatch(str(value))
+    if not match:
+        return None
+    width, height, refresh = match.groups()
+    return f"{int(width)}x{int(height)}@{float(refresh):g}"
+
+
+def monitors():
+    try:
+        result = subprocess.run([HYPRCTL, "-j", "monitors", "all"], capture_output=True,
+                                text=True, timeout=4, check=False)
+        if result.returncode or len(result.stdout) > 262144:
+            fail("Hyprland could not list displays")
+        raw = json.loads(result.stdout)
+        if not isinstance(raw, list):
+            fail("Hyprland returned invalid display data")
+    except (OSError, subprocess.SubprocessError, json.JSONDecodeError):
+        fail("Hyprland could not list displays")
+    output = []
+    for item in raw[:16]:
+        if not isinstance(item, dict):
+            continue
+        name = item.get("name", "")
+        if not isinstance(name, str) or not NAME_RE.fullmatch(name):
+            continue
+        try:
+            width = int(item.get("width", 0))
+            height = int(item.get("height", 0))
+            scale = float(item.get("scale", 1))
+            refresh = float(item.get("refreshRate", 0))
+        except (TypeError, ValueError):
+            continue
+        available = []
+        modes = item.get("availableModes", [])
+        if isinstance(modes, list):
+            for mode in modes[:128]:
+                normalized = canonical_mode(mode)
+                if normalized and normalized not in available:
+                    available.append(normalized)
+        current = canonical_mode(f"{width}x{height}@{refresh}") if width and height and refresh else ""
+        output.append({
+            "name": name,
+            "width": width,
+            "height": height,
+            "currentMode": current or "",
+            "scale": f"{scale:g}",
+            "availableModes": available,
+            "internal": name.startswith(("DSI-", "eDP-")),
+        })
+    return output
+
+
+def ensure_config_dir(home):
+    for directory in (home / ".config", home / ".config" / "hypr"):
+        try:
+            info = directory.lstat()
+        except FileNotFoundError:
+            directory.mkdir(mode=0o700)
+            info = directory.lstat()
+        if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid():
+            fail("Hyprland config directory is unsafe")
+    return home / ".config" / "hypr" / "monitors.lua"
+
+
+def read_config(path):
+    try:
+        info = path.lstat()
+    except FileNotFoundError:
+        return "", {}, None
+    if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_size > 262144:
+        fail("Hyprland monitor config is unsafe")
+    try:
+        text = path.read_text(encoding="utf-8")
+    except (OSError, UnicodeError):
+        fail("Hyprland monitor config cannot be read")
+    start = text.count(START)
+    end = text.count(END)
+    if start != end or start > 1:
+        fail("Hyprland monitor config has an invalid managed section")
+    records = {}
+    if not start:
+        return text, records, stat.S_IMODE(info.st_mode)
+    begin = text.index(START)
+    finish = text.index(END, begin) + len(END)
+    block = text[begin:finish]
+    managed = block.splitlines()[1:-1]
+    if len(managed) % 2:
+        fail("Hyprland monitor config has an invalid managed section")
+    for index in range(0, len(managed), 2):
+        line = managed[index]
+        rule = managed[index + 1]
+        prefix = "-- omamobile-display: "
+        if not line.startswith(prefix):
+            fail("Hyprland monitor config has an invalid managed entry")
+        try:
+            record = json.loads(line[len(prefix):])
+        except json.JSONDecodeError:
+            fail("Hyprland monitor config has an invalid managed entry")
+        name = record.get("name") if isinstance(record, dict) else None
+        mode = canonical_mode(record.get("mode", "")) if isinstance(record, dict) else None
+        scale = str(record.get("scale", "")) if isinstance(record, dict) else ""
+        if not isinstance(name, str) or not NAME_RE.fullmatch(name) or not mode or scale not in SCALES:
+            fail("Hyprland monitor config has an invalid managed entry")
+        expected = f'hl.monitor({{ output = "{name}", mode = "{mode}", position = "auto", scale = {scale} }})'
+        if rule != expected:
+            fail("Hyprland monitor config has an invalid managed rule")
+        records[name] = {"name": name, "mode": mode, "scale": scale}
+    prefix_text = text[:begin]
+    suffix_text = text[finish:]
+    clean = prefix_text.rstrip("\n")
+    if clean and suffix_text:
+        clean += "\n\n" + suffix_text.lstrip("\n")
+    elif clean:
+        clean += "\n"
+    else:
+        clean = suffix_text.lstrip("\n")
+    return clean, records, stat.S_IMODE(info.st_mode)
+
+
+def atomic_write(path, content, mode):
+    fd, temporary = tempfile.mkstemp(prefix=".monitors.lua.", dir=path.parent)
+    try:
+        with os.fdopen(fd, "w", encoding="utf-8") as stream:
+            stream.write(content)
+            stream.flush()
+            os.fsync(stream.fileno())
+        os.chmod(temporary, mode)
+        os.replace(temporary, path)
+        directory_fd = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
+        try:
+            os.fsync(directory_fd)
+        finally:
+            os.close(directory_fd)
+    finally:
+        try:
+            os.unlink(temporary)
+        except FileNotFoundError:
+            pass
+
+
+def render(base, records):
+    lines = [START]
+    for name in sorted(records):
+        record = records[name]
+        lines.append("-- omamobile-display: " + json.dumps(record, sort_keys=True, separators=(",", ":")))
+        lines.append(f'hl.monitor({{ output = "{name}", mode = "{record["mode"]}", position = "auto", scale = {record["scale"]} }})')
+    lines.append(END)
+    block = "\n".join(lines)
+    if START in base:
+        begin = base.index(START)
+        finish = base.index(END, begin) + len(END)
+        result = base[:begin] + block + base[finish:]
+    else:
+        result = base + ("\n" if base and not base.endswith("\n") else "")
+        result += ("\n" if result else "") + block + "\n"
+    return result
+
+
+def restore(path, previous, mode):
+    if previous is None:
+        try:
+            path.unlink()
+        except FileNotFoundError:
+            pass
+    else:
+        atomic_write(path, previous, mode)
+
+
+def main(args):
+    if args == ["get"]:
+        print(json.dumps({"monitors": monitors()}, separators=(",", ":")))
+        return
+    if len(args) != 4 or args[0] != "set":
+        fail("usage: get|set <name> <mode> <scale>")
+    _, name, requested_mode, scale = args
+    if not NAME_RE.fullmatch(name) or scale not in SCALES:
+        fail("invalid display selection")
+    mode = canonical_mode(requested_mode)
+    if not mode:
+        fail("invalid display mode")
+    outputs = monitors()
+    selected = next((monitor for monitor in outputs if monitor["name"] == name), None)
+    if not selected or selected["internal"]:
+        fail("the built-in panel is read-only or the display disconnected")
+    if mode not in selected["availableModes"]:
+        fail("that mode is not available on this display")
+
+    home = pathlib.Path.home()
+    path = ensure_config_dir(home)
+    base, records, file_mode = read_config(path)
+    previous = path.read_text(encoding="utf-8") if path.exists() else None
+    mode_bits = file_mode if file_mode is not None else 0o600
+    records[name] = {"name": name, "mode": mode, "scale": scale}
+    atomic_write(path, render(base, records), mode_bits)
+
+    lua = f'hl.monitor({{ output = "{name}", mode = "{mode}", position = "auto", scale = {scale} }})'
+    try:
+        result = subprocess.run([HYPRCTL, "eval", lua], capture_output=True, text=True,
+                                timeout=5, check=False)
+        if result.returncode or "error" in (result.stdout + result.stderr).lower():
+            raise RuntimeError
+    except (OSError, subprocess.SubprocessError, RuntimeError):
+        restore(path, previous, mode_bits)
+        fail("Hyprland did not accept the display settings")
+    print(json.dumps({"monitors": monitors(), "saved": True}, separators=(",", ":")))
+
+
+main(sys.argv[1:])
+PY
