+// SPDX-License-Identifier: MIT
+import QtQuick
+import QtQuick.Controls
+import QtQuick.Layouts
+import "."
+
+ColumnLayout {
+    id: page
+    spacing: 12
+    property var monitors: []
+    property string status: qsTr("Reading connected displays…")
+    property bool busy: true
+    property int reqId: -1
+    readonly property var scales: ["1", "1.25", "1.5", "1.75", "2", "2.25", "2.5", "2.75", "3"]
+
+    function apply(r) {
+        busy = false
+        if (r.error) { status = r.error; return }
+        monitors = r.monitors || []
+        status = monitors.length ? qsTr("External display settings are saved in Hyprland's monitor configuration.")
+                                 : qsTr("No connected displays were found.")
+    }
+    function refresh() {
+        busy = true
+        status = qsTr("Reading connected displays…")
+        reqId = actions.run("displays", ["get"])
+    }
+    Connections {
+        target: actions
+        function onFinished(tool, result, id) {
+            if (tool === "displays" && id === page.reqId) page.apply(result)
+        }
+    }
+    Component.onCompleted: refresh()
+
+    Flickable {
+        Layout.fillWidth: true
+        Layout.fillHeight: true
+        contentWidth: width
+        contentHeight: content.implicitHeight
+        clip: true
+        ColumnLayout {
+            id: content
+            width: parent.width
+            spacing: 14
+            Repeater {
+                model: page.monitors
+                delegate: ColumnLayout {
+                    required property var modelData
+                    property var output: modelData
+                    Layout.fillWidth: true
+                    spacing: 8
+                    SettingsLabel {
+                        text: output.name
+                        color: backend.foreground
+                        font.pixelSize: SettingsStyle.fontPx(17)
+                        font.weight: Font.DemiBold
+                        Layout.fillWidth: true
+                    }
+                    SettingsLabel {
+                        text: output.currentMode.length ? qsTr("Current: %1 · scale %2").arg(output.currentMode).arg(output.scale)
+                                                        : qsTr("Display connected")
+                        color: backend.muted
+                        font.pixelSize: SettingsStyle.fontPx(13)
+                        Layout.fillWidth: true
+                    }
+                    SettingsLabel {
+                        visible: output.internal
+                        text: qsTr("The built-in phone panel is managed by the phone profile.")
+                        color: backend.muted
+                        font.pixelSize: SettingsStyle.fontPx(13)
+                        wrapMode: Text.Wrap
+                        Layout.fillWidth: true
+                    }
+                    ColumnLayout {
+                        visible: !output.internal
+                        Layout.fillWidth: true
+                        spacing: 8
+                        SettingsLabel { text: qsTr("Resolution and refresh rate"); color: backend.foreground; font.weight: Font.DemiBold }
+                        ComboBox {
+                            id: modeChoice
+                            objectName: "displayMode_" + output.name
+                            Layout.fillWidth: true
+                            model: output.availableModes
+                            currentIndex: Math.max(0, output.availableModes.indexOf(output.currentMode))
+                            enabled: !page.busy && output.availableModes.length > 0
+                        }
+                        SettingsLabel { text: qsTr("Scale"); color: backend.foreground; font.weight: Font.DemiBold }
+                        ComboBox {
+                            id: scaleChoice
+                            objectName: "displayScale_" + output.name
+                            Layout.fillWidth: true
+                            model: page.scales
+                            currentIndex: Math.max(0, page.scales.indexOf(String(output.scale)))
+                            enabled: !page.busy
+                        }
+                        SettingsButton {
+                            Layout.fillWidth: true
+                            Layout.preferredHeight: 52
+                            text: qsTr("Apply to %1").arg(output.name)
+                            enabled: !page.busy && modeChoice.currentText.length > 0
+                            onClicked: {
+                                page.busy = true
+                                page.status = qsTr("Applying display settings…")
+                                page.reqId = actions.run("displays", ["set", output.name, modeChoice.currentText, scaleChoice.currentText])
+                            }
+                        }
+                    }
+                    Rectangle { Layout.fillWidth: true; height: 1; color: backend.muted; opacity: 0.25 }
+                }
+            }
+            SettingsLabel {
+                visible: page.monitors.length === 0 || page.busy || page.status.length > 0
+                text: page.status
+                color: backend.muted
+                font.pixelSize: SettingsStyle.fontPx(13)
+                wrapMode: Text.Wrap
+                Layout.fillWidth: true
+            }
+            SettingsButton {
+                Layout.fillWidth: true
+                Layout.preferredHeight: 52
+                text: qsTr("Refresh displays")
+                enabled: !page.busy
+                onClicked: page.refresh()
+            }
+        }
+    }
+}
