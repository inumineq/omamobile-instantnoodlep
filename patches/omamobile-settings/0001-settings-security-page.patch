+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 Marsel Nenaj
+#pragma once
+#include <QObject>
+#include <QProcess>
+
+class CredentialsController : public QObject {
+    Q_OBJECT
+    Q_PROPERTY(bool separatePinEnabled READ separatePinEnabled NOTIFY stateChanged)
+    Q_PROPERTY(bool keypadEnabled READ keypadEnabled NOTIFY stateChanged)
+public:
+    explicit CredentialsController(QObject *parent = nullptr);
+    bool separatePinEnabled() const { return m_separatePin; }
+    bool keypadEnabled() const { return m_keypad; }
+    Q_INVOKABLE void refresh();
+    Q_INVOKABLE void setPin(const QString &secret, const QString &confirm);
+    Q_INVOKABLE void setAccountPassword(const QString &secret, const QString &confirm);
+    Q_INVOKABLE void enableSeparatePin(const QString &secret, const QString &confirm);
+    Q_INVOKABLE void useAccountPasswordForLock();
+    Q_INVOKABLE void setKeypadEnabled(bool enabled);
+signals:
+    void stateChanged();
+    void finished(const QString &action, bool ok, const QString &message);
+private:
+    void run(const QString &action, const QByteArray &request);
+    bool m_separatePin = false;
+    bool m_keypad = false;
+    QProcess *m_process = nullptr;
+};
