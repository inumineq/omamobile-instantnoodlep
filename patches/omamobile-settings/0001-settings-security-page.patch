+++ b/app/credentialscontroller.cpp
@@ -0,0 +1,70 @@
+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 Marsel Nenaj
+#include "credentialscontroller.h"
+#include <QDir>
+#include <QFile>
+#include <QFileInfo>
+#include <QJsonDocument>
+#include <QJsonObject>
+#include <QProcessEnvironment>
+
+CredentialsController::CredentialsController(QObject *parent) : QObject(parent) { refresh(); }
+void CredentialsController::refresh() {
+    QFile mode(QDir::homePath() + "/.config/omamobile/credential-mode");
+    const bool separate = mode.open(QIODevice::ReadOnly) && mode.read(64).trimmed() == "separate-pin";
+    const bool keypad = QFileInfo::exists(QDir::homePath() + "/.local/state/omarchy/toggles/lock-keypad");
+    if (separate != m_separatePin || keypad != m_keypad) {
+        m_separatePin = separate;
+        m_keypad = keypad;
+        emit stateChanged();
+    }
+}
+void CredentialsController::run(const QString &action, const QByteArray &request) {
+    if (m_process && m_process->state() != QProcess::NotRunning) {
+        emit finished(action, false, tr("Another security change is still running."));
+        return;
+    }
+    auto *process = new QProcess(this);
+    m_process = process;
+    auto env = QProcessEnvironment::systemEnvironment();
+    env.remove("BASH_ENV"); env.remove("ENV");
+    process->setProcessEnvironment(env);
+    process->setProgram("/usr/bin/pkexec");
+    process->setArguments({"/usr/lib/omamobile-settings/credentials-helper", action});
+    connect(process, &QProcess::started, this, [process, request] {
+        process->write(request);
+        process->closeWriteChannel();
+    });
+    connect(process, &QProcess::finished, this, [this, process, action](int code, QProcess::ExitStatus status) {
+        const auto raw = process->readAllStandardOutput().left(4096);
+        process->readAllStandardError();
+        const auto obj = QJsonDocument::fromJson(raw).object();
+        const bool ok = status == QProcess::NormalExit && code == 0 && obj.value("ok").toBool();
+        QString message = obj.value("error").toString();
+        if (!ok && message.isEmpty()) message = tr("The security change was cancelled or failed.");
+        if (ok) refresh();
+        emit finished(action, ok, message);
+        process->deleteLater();
+        if (m_process == process) m_process = nullptr;
+    });
+    connect(process, &QProcess::errorOccurred, this, [this, process, action](QProcess::ProcessError error) {
+        if (error != QProcess::FailedToStart) return;
+        emit finished(action, false, tr("Could not start the privileged security helper."));
+        process->deleteLater();
+        if (m_process == process) m_process = nullptr;
+    });
+    process->start();
+}
+void CredentialsController::setPin(const QString &secret, const QString &confirm) {
+    run("set-pin", QJsonDocument(QJsonObject{{"secret", secret}, {"confirm", confirm}}).toJson(QJsonDocument::Compact));
+}
+void CredentialsController::setAccountPassword(const QString &secret, const QString &confirm) {
+    run("set-account-password", QJsonDocument(QJsonObject{{"secret", secret}, {"confirm", confirm}}).toJson(QJsonDocument::Compact));
+}
+void CredentialsController::enableSeparatePin(const QString &secret, const QString &confirm) {
+    run("set-separate-pin", QJsonDocument(QJsonObject{{"secret", secret}, {"confirm", confirm}}).toJson(QJsonDocument::Compact));
+}
+void CredentialsController::useAccountPasswordForLock() { run("use-account-password", "{\"enabled\":true}"); }
+void CredentialsController::setKeypadEnabled(bool enabled) {
+    run("set-keypad", enabled ? "{\"enabled\":true}" : "{\"enabled\":false}");
+}
