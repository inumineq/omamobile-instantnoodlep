diff --git a/test/security-auth-container.sh b/test/security-auth-container.sh
new file mode 100755
index 0000000..9689aa2
--- /dev/null
+++ b/test/security-auth-container.sh
@@ -0,0 +1,67 @@
+#!/bin/bash
+# SPDX-License-Identifier: MIT
+set -euo pipefail
+fail() { echo "not ok - $*" >&2; exit 1; }
+pass() { echo "ok - $*"; }
+cat >/etc/pam.d/omarchy-lock-password <<'PAM'
+#%PAM-1.0
+auth required pam_unix.so try_first_pass
+account required pam_unix.so
+PAM
+cat >/etc/pam.d/system-local-login <<'PAM'
+#%PAM-1.0
+auth include system-auth
+account include system-auth
+PAM
+cat >/etc/pam.d/system-auth <<'PAM'
+#%PAM-1.0
+auth required pam_unix.so
+account required pam_unix.so
+PAM
+# Throwaway fixture only: Debian runs pam_pwquality on the chpasswd path and
+# would refuse the 4-digit test PIN as account password. The target system
+# (Arch) has no quality gate there, so pin a plain pam_unix password stack.
+cat >/etc/pam.d/chpasswd <<'PAM'
+#%PAM-1.0
+auth required pam_permit.so
+account required pam_permit.so
+password required pam_unix.so yescrypt
+PAM
+# Debian keeps chpasswd in /usr/sbin; the helper targets Arch's /usr/bin path.
+ln -sf /usr/sbin/chpasswd /usr/bin/chpasswd
+useradd -m settings-test
+useradd -m lockout-test
+useradd -m ordinary-test
+printf 'settings-test:initial-account-password\nlockout-test:initial-account-password\nordinary-test:ordinary-account-password\n' | chpasswd
+uid=$(id -u settings-test)
+run_helper() { PKEXEC_UID="$1" /usr/lib/omamobile-settings/credentials-helper "$2"; }
+try_auth() { printf '%s\n' "$3" | pamtester "$1" "$2" authenticate >/dev/null 2>&1; }
+expect_auth() { if try_auth "$1" "$2" "$3"; then pass "$4"; else fail "$4"; fi; }
+expect_reject() { if try_auth "$1" "$2" "$3"; then fail "$4"; else pass "$4"; fi; }
+printf '{"enabled":true}' | run_helper "$uid" set-keypad >/dev/null
+test -f /home/settings-test/.local/state/omarchy/toggles/lock-keypad || fail 'numeric keypad toggle enables the shell option'
+printf '{"enabled":false}' | run_helper "$uid" set-keypad >/dev/null
+test ! -e /home/settings-test/.local/state/omarchy/toggles/lock-keypad || fail 'numeric keypad toggle disables the shell option'
+printf '{"secret":"1234","confirm":"1234"}' | run_helper "$uid" set-pin >/dev/null
+expect_auth omarchy-lock-password settings-test 1234 'default mode keeps one account PIN/password'
+expect_reject system-auth settings-test initial-account-password 'PIN changes the single account secret'
+printf '{"secret":"Account-long-Password-1","confirm":"Account-long-Password-1"}' | run_helper "$uid" set-account-password >/dev/null
+expect_auth system-auth settings-test Account-long-Password-1 'account password changes through helper'
+printf '{"secret":"2468","confirm":"2468"}' | run_helper "$uid" set-pin >/dev/null
+printf '{"secret":"1357","confirm":"1357"}' | run_helper "$uid" set-separate-pin >/dev/null
+test "$(stat -c '%u:%g:%a' /var/lib/omamobile/lock-pin/"$uid")" = "0:$(id -g settings-test):640" || fail 'separate hash is root-owned, group-readable to private primary group, mode 0640'
+expect_auth omarchy-lock-password settings-test 1357 'separate PIN authenticates lock service'
+expect_reject omarchy-lock-password settings-test 2468 'account password does not fall through to lock PIN'
+expect_auth system-auth settings-test 2468 'account password remains valid for sudo PAM service'
+printf '{"secret":"Updated-account-password-2","confirm":"Updated-account-password-2"}' | run_helper "$uid" set-account-password >/dev/null
+expect_auth omarchy-lock-password settings-test 1357 'account password change leaves separate lock PIN unchanged'
+expect_auth system-auth settings-test Updated-account-password-2 'sudo PAM checks the updated account password'
+expect_auth omarchy-lock-password ordinary-test ordinary-account-password 'non-opted-in users retain account-password authentication'
+printf '{"enabled":true}' | run_helper "$uid" use-account-password >/dev/null
+expect_auth omarchy-lock-password settings-test Updated-account-password-2 'disabling separate PIN restores account-password lock authentication'
+expect_reject omarchy-lock-password settings-test 1357 'restored single-secret lock no longer accepts the separate PIN'
+uid2=$(id -u lockout-test)
+printf '{"secret":"1357","confirm":"1357"}' | run_helper "$uid2" set-separate-pin >/dev/null
+for _ in $(seq 1 10); do try_auth omarchy-lock-password lockout-test 0000 || true; done
+expect_reject omarchy-lock-password lockout-test 1357 'ten failed lock PIN attempts enforce lockout'
+pass 'pamtester used test accounts in isolated container'
