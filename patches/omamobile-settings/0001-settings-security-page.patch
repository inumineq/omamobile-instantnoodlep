diff --git a/bin/credentials-helper b/bin/credentials-helper
new file mode 100755
index 0000000..a2cc083
--- /dev/null
+++ b/bin/credentials-helper
@@ -0,0 +1,290 @@
+#!/usr/bin/python3
+# SPDX-License-Identifier: MIT
+import json
+import grp
+import os
+import pathlib
+import pwd
+import stat
+import shutil
+import subprocess
+import sys
+import tempfile
+
+PAM_PATH = pathlib.Path('/etc/pam.d/omarchy-lock-password')
+PAM_BACKUP = pathlib.Path('/etc/pam.d/.omarchy-lock-password.omamobile-backup')
+
+
+
+def atomic_write(path, data, mode, uid=0, gid=0):
+    if uid != 0:
+        home = pathlib.Path(pwd.getpwuid(uid).pw_dir).resolve()
+        parent = path.parent.resolve()
+        if not parent.is_relative_to(home) or path.is_symlink():
+            raise ValueError('Refusing an unsafe user config path')
+    path.parent.mkdir(parents=True, exist_ok=True)
+    fd, tmp = tempfile.mkstemp(prefix='.' + path.name, dir=path.parent)
+    try:
+        with os.fdopen(fd, 'wb') as stream:
+            stream.write(data)
+            stream.flush()
+            os.fsync(stream.fileno())
+        os.chown(tmp, uid, gid)
+        os.chmod(tmp, mode)
+        os.replace(tmp, path)
+    finally:
+        try:
+            os.unlink(tmp)
+        except FileNotFoundError:
+            pass
+
+
+def read_request():
+    raw = sys.stdin.buffer.read(8193)
+    if len(raw) > 8192:
+        raise ValueError('Request is too large')
+    request = json.loads(raw)
+    if not isinstance(request, dict):
+        raise ValueError('Invalid request')
+    return request
+
+
+def require_secret(request, field):
+    value = request.get(field)
+    if not isinstance(value, str) or not 1 <= len(value) <= 256:
+        raise ValueError('Enter a value from 1 to 256 characters')
+    if any(c in value for c in '\x00\r\n:'):
+        raise ValueError('The value contains an unsupported character')
+    return value
+
+
+def user_context():
+    if os.geteuid() != 0:
+        raise ValueError('This operation requires pkexec')
+    raw_uid = os.environ.get('PKEXEC_UID', '')
+    if not raw_uid.isdigit():
+        raise ValueError('Cannot identify the requesting user')
+    user = pwd.getpwuid(int(raw_uid))
+    if user.pw_uid == 0 or not user.pw_dir.startswith('/home/'):
+        raise ValueError('Unsupported account')
+    return user
+
+
+def set_password(user, value):
+    proc = subprocess.run(['/usr/bin/chpasswd'], input=f'{user.pw_name}:{value}\n',
+                         text=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+    if proc.returncode:
+        raise ValueError('Account password could not be changed')
+
+
+def ensure_user_directory(user, parts):
+    current = pathlib.Path(user.pw_dir)
+    for part in parts:
+        current = current / part
+        try:
+            st = current.lstat()
+        except FileNotFoundError:
+            current.mkdir(mode=0o700)
+            os.chown(current, user.pw_uid, user.pw_gid)
+            st = current.lstat()
+        if not stat.S_ISDIR(st.st_mode) or st.st_uid != user.pw_uid:
+            raise ValueError('Unsafe user settings directory')
+    return current
+
+def set_user_record(user, path, data, mode=0o600):
+    relative_parent = path.parent.relative_to(user.pw_dir)
+    ensure_user_directory(user, relative_parent.parts)
+    atomic_write(path, data.encode(), mode, user.pw_uid, user.pw_gid)
+
+
+def private_primary_group(user):
+    try:
+        group = grp.getgrgid(user.pw_gid)
+    except KeyError:
+        return False
+    member_names = set(group.gr_mem)
+    member_names.add(user.pw_name)
+    members = {entry.pw_name for entry in pwd.getpwall() if entry.pw_gid == user.pw_gid}
+    return members <= {user.pw_name} and member_names <= {user.pw_name}
+
+def hash_pin(user, value, separate):
+    if not value.isascii() or not value.isdigit() or not 4 <= len(value) <= 12:
+        raise ValueError('PIN must contain 4 to 12 digits')
+    if separate and not private_primary_group(user):
+        raise ValueError('Separate PIN requires a private primary user group')
+    salt = 'rounds=100000$' + subprocess.run(['/usr/bin/openssl', 'rand', '-hex', '16'], check=True,
+                          stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True).stdout.strip()
+    hashed = subprocess.run(['/usr/bin/openssl', 'passwd', '-6', '-salt', salt, '-stdin'],
+                            input=value + '\n', text=True, check=True, capture_output=True).stdout.strip()
+    pin_path = pathlib.Path('/var/lib/omamobile/lock-pin') / str(user.pw_uid)
+    pin_path.parent.mkdir(parents=True, mode=0o711, exist_ok=True)
+    os.chown(pin_path.parent, 0, 0)
+    os.chmod(pin_path.parent, 0o711)
+    atomic_write(pin_path, (hashed + '\n').encode(), 0o640 if separate else 0o600,
+                 0, user.pw_gid if separate else 0)
+
+
+def set_pin(user, value):
+    if not value.isascii() or not value.isdigit() or not 4 <= len(value) <= 12:
+        raise ValueError('PIN must contain 4 to 12 digits')
+    home = pathlib.Path(user.pw_dir)
+    separate = (home / '.config/omamobile/credential-mode').exists() and \
+        (home / '.config/omamobile/credential-mode').read_text().strip() == 'separate-pin'
+    if separate:
+        hash_pin(user, value, True)
+    else:
+        set_password(user, value)
+    set_credential_type(user, 'pin')
+
+
+def render_pin_pam(uids):
+    lines = ['#%PAM-1.0',
+             'auth requisite pam_faillock.so preauth silent deny=10 unlock_time=120']
+    for uid in sorted(uids, key=int):
+        lines.extend([
+            f'auth [success=3 default=ignore] pam_succeed_if.so uid != {uid} quiet',
+            'auth [success=1 default=ignore] pam_exec.so expose_authtok /usr/lib/omamobile-settings/verify-lock-pin',
+            'auth [default=die] pam_faillock.so authfail deny=10 unlock_time=120',
+            'auth sufficient pam_faillock.so authsucc',
+        ])
+    lines.extend(['auth substack system-local-login', 'account include system-local-login', ''])
+    return '\n'.join(lines)
+
+
+def switch_separate(user, enabled):
+    home = pathlib.Path(user.pw_dir)
+    pin_path = pathlib.Path('/var/lib/omamobile/lock-pin') / str(user.pw_uid)
+    roster = pathlib.Path('/etc/omamobile/lock-pin-users')
+    current = roster.read_text().splitlines() if roster.exists() else []
+    users = {line for line in current if line.isdigit()}
+    if enabled:
+        if not pin_path.is_file():
+            raise ValueError('Set a lock-screen PIN before enabling a separate PIN')
+        if not private_primary_group(user):
+            raise ValueError('Separate PIN requires a private primary user group')
+        os.chown(pin_path, 0, user.pw_gid)
+        os.chmod(pin_path, 0o640)
+        if not PAM_PATH.exists():
+            raise ValueError('Omarchy lock PAM service is missing')
+        if users and not PAM_BACKUP.exists():
+            raise ValueError('Saved lock PAM service is missing')
+        if not users and not PAM_BACKUP.exists():
+            shutil.copyfile(PAM_PATH, PAM_BACKUP)
+            os.chown(PAM_BACKUP, 0, 0)
+            os.chmod(PAM_BACKUP, 0o600)
+        credential = home / '.config/omamobile/credential'
+        previous = credential.read_text().strip() if credential.exists() else 'password'
+        if previous not in ('pin', 'password'):
+            previous = 'password'
+        set_user_record(user, home / '.config/omamobile/credential-mode-backup', previous + '\n')
+        set_user_record(user, home / '.config/omamobile/credential-mode', 'separate-pin\n')
+        set_credential_type(user, 'pin')
+        users.add(str(user.pw_uid))
+        atomic_write(roster, ('\n'.join(sorted(users, key=int)) + '\n').encode(), 0o600)
+        atomic_write(PAM_PATH, render_pin_pam(users).encode(), 0o644)
+    else:
+        users.discard(str(user.pw_uid))
+        if users:
+            atomic_write(roster, ('\n'.join(sorted(users, key=int)) + '\n').encode(), 0o600)
+            atomic_write(PAM_PATH, render_pin_pam(users).encode(), 0o644)
+        else:
+            if not PAM_BACKUP.is_file():
+                raise ValueError('No saved lock PAM service is available to restore')
+            atomic_write(PAM_PATH, PAM_BACKUP.read_bytes(), 0o644)
+            PAM_BACKUP.unlink()
+            try:
+                roster.unlink()
+            except FileNotFoundError:
+                pass
+        set_user_record(user, home / '.config/omamobile/credential-mode', 'single-secret\n')
+        previous_path = home / '.config/omamobile/credential-mode-backup'
+        previous = previous_path.read_text().strip() if previous_path.exists() else 'password'
+        set_credential_type(user, previous if previous in ('pin', 'password') else 'password')
+        try:
+            previous_path.unlink()
+        except FileNotFoundError:
+            pass
+        try:
+            pin_path.unlink()
+        except FileNotFoundError:
+            pass
+
+
+def set_credential_type(user, kind):
+    home = pathlib.Path(user.pw_dir)
+    set_user_record(user, home / '.config/omamobile/credential', kind + '\n')
+    keypad = home / '.local/state/omarchy/toggles/credential-password'
+    ensure_user_directory(user, ('.local', 'state', 'omarchy', 'toggles'))
+    if kind == 'password':
+        fd = os.open(keypad, os.O_WRONLY | os.O_CREAT | os.O_CLOEXEC | os.O_NOFOLLOW, 0o600)
+        os.close(fd)
+        os.chown(keypad, user.pw_uid, user.pw_gid)
+    else:
+        try:
+            keypad.unlink()
+        except FileNotFoundError:
+            pass
+
+
+def set_keypad(user, enabled):
+    path = pathlib.Path(user.pw_dir) / '.local/state/omarchy/toggles/lock-keypad'
+    ensure_user_directory(user, ('.local', 'state', 'omarchy', 'toggles'))
+    if enabled:
+        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_CLOEXEC | os.O_NOFOLLOW, 0o600)
+        os.close(fd)
+    else:
+        try:
+            path.unlink()
+        except FileNotFoundError:
+            pass
+    if enabled:
+        os.chown(path, user.pw_uid, user.pw_gid)
+
+
+def main():
+    action = sys.argv[1] if len(sys.argv) == 2 else ''
+    user = user_context()
+    req = read_request()
+    if action == 'set-account-password':
+        first = require_secret(req, 'secret')
+        if first != require_secret(req, 'confirm'):
+            raise ValueError('Passwords do not match')
+        set_password(user, first)
+        home = pathlib.Path(user.pw_dir)
+        mode_path = home / '.config/omamobile/credential-mode'
+        separate = mode_path.exists() and mode_path.read_text().strip() == 'separate-pin'
+        if separate:
+            set_user_record(user, home / '.config/omamobile/credential-mode-backup', 'password\n')
+        else:
+            set_credential_type(user, 'password')
+    elif action == 'set-pin':
+        first = require_secret(req, 'secret')
+        if first != require_secret(req, 'confirm'):
+            raise ValueError('PINs do not match')
+        set_pin(user, first)
+    elif action == 'set-separate-pin':
+        first = require_secret(req, 'secret')
+        if first != require_secret(req, 'confirm'):
+            raise ValueError('PINs do not match')
+        hash_pin(user, first, False)
+        switch_separate(user, True)
+    elif action == 'use-account-password':
+        if req.get('enabled') is not True:
+            raise ValueError('Invalid setting')
+        switch_separate(user, False)
+    elif action == 'set-keypad':
+        if not isinstance(req.get('enabled'), bool):
+            raise ValueError('Invalid setting')
+        set_keypad(user, req['enabled'])
+    else:
+        raise ValueError('Unknown operation')
+    print('{"ok":true}')
+
+
+if __name__ == '__main__':
+    try:
+        main()
+    except Exception as error:
+        message = str(error)
+        print(json.dumps({'ok': False, 'error': message[:180]}))
+        sys.exit(1)
diff --git a/bin/verify-lock-pin b/bin/verify-lock-pin
new file mode 100755
index 0000000..8b149f2
--- /dev/null
+++ b/bin/verify-lock-pin
@@ -0,0 +1,28 @@
+#!/usr/bin/python3
+# SPDX-License-Identifier: MIT
+import hmac
+import os
+import pathlib
+import pwd
+import subprocess
+import sys
+
+try:
+    account = pwd.getpwnam(os.environ['PAM_USER'])
+    path = pathlib.Path('/var/lib/omamobile/lock-pin') / str(account.pw_uid)
+    st = path.stat()
+    if st.st_uid != 0 or st.st_gid != account.pw_gid or st.st_mode & 0o777 != 0o640:
+        raise ValueError('unsafe PIN hash permissions')
+    stored = path.read_text().strip()
+    if not stored.startswith('$6$rounds=100000$'):
+        raise ValueError('unsupported PIN hash')
+    salt = stored.split('$')[2] + '$' + stored.split('$')[3]
+    candidate = sys.stdin.readline(257).rstrip('\n')
+    if len(candidate) > 256:
+        raise ValueError('oversized PIN')
+    result = subprocess.run(['/usr/bin/openssl', 'passwd', '-6', '-salt', salt, '-stdin'],
+                            input=candidate + '\n', text=True, check=True,
+                            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL).stdout.strip()
+    sys.exit(0 if hmac.compare_digest(result, stored) else 1)
+except Exception:
+    sys.exit(1)
