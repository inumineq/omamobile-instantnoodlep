diff --git a/packages/omamobile-shell/plugins/omamobile.safeinsets/SafeInsets.qml b/packages/omamobile-shell/plugins/omamobile.safeinsets/SafeInsets.qml
new file mode 100644
index 0000000..9ac573b
--- /dev/null
+++ b/packages/omamobile-shell/plugins/omamobile.safeinsets/SafeInsets.qml
@@ -0,0 +1,49 @@
+// SPDX-License-Identifier: MIT
+import Quickshell
+import Quickshell.Io
+import QtQuick
+
+// Device physical-pixel UI geometry. The device package installs this file
+// at /usr/share/omamobile/device-ui.conf; absent or invalid files are zero.
+Item {
+  id: root
+  visible: false
+  property var pixels: ({ left: 0, top: 0, right: 0, bottom: 0, gesture: 0 })
+  readonly property real outputScale: Screen.devicePixelRatio > 0 ? Screen.devicePixelRatio : 1
+  readonly property real leftInset: pixels.left / outputScale
+  readonly property real topInset: pixels.top / outputScale
+  readonly property real rightInset: pixels.right / outputScale
+  readonly property real bottomInset: pixels.bottom / outputScale
+  readonly property real gestureEdgeWidth: pixels.gesture / outputScale
+
+  function bounded(value) {
+    var number = Number(value)
+    return Number.isFinite(number) ? Math.max(0, Math.min(512, Math.round(number))) : 0
+  }
+
+  function parse(text) {
+    var next = { left: 0, top: 0, right: 0, bottom: 0, gesture: 0 }
+    var rows = String(text).split("\n")
+    for (var i = 0; i < rows.length; i++) {
+      var match = rows[i].match(/^\s*(safe_insets_px|gesture_edge_width_px)\s*=\s*(.*?)\s*$/)
+      if (!match) continue
+      var values = match[2].split(",")
+      if (match[1] === "safe_insets_px" && values.length === 4) {
+        next.left = bounded(values[0]); next.top = bounded(values[1])
+        next.right = bounded(values[2]); next.bottom = bounded(values[3])
+      } else if (match[1] === "gesture_edge_width_px" && values.length === 1) {
+        next.gesture = bounded(values[0])
+      }
+    }
+    pixels = next
+  }
+
+  FileView {
+    path: "/usr/share/omamobile/device-ui.conf"
+    watchChanges: true
+    printErrors: false
+    onLoaded: root.parse(text())
+    onLoadFailed: root.pixels = ({ left: 0, top: 0, right: 0, bottom: 0, gesture: 0 })
+    onFileChanged: reload()
+  }
+}
