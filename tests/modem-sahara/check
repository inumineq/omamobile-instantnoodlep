# SPDX-License-Identifier: MIT
"""Exercise the actual candidate loader with a synthetic MHI/firmware transport.

Usage: tests/modem-sahara/check /path/to/instantnoodlep-k3-modem
No phone, firmware bytes or network required. This is not DMA/lifecycle testing.
"""
import os
from pathlib import Path
import subprocess
import sys
import tempfile

root = Path(__file__).resolve().parent
kernel = Path(sys.argv[1]).resolve()
source = kernel / "drivers/bus/mhi/host/sahara.c"
with tempfile.TemporaryDirectory(prefix="sahara-check-") as directory:
    temp = Path(directory)
    (temp / "linux").mkdir()
    for header in ("completion firmware jiffies mhi module pci property sizes "
                   "slab spinlock workqueue").split():
        (temp / "linux" / (header + ".h")).write_text('#include "shim.h"\n')
    subprocess.run([os.environ.get("CC", "cc"), "-std=gnu11", "-g",
                    "-fsanitize=address,undefined", "-I", str(temp),
                    "-I", str(root), '-DLOADER_SOURCE="' + str(source) + '"',
                    str(root / "check.c"), "-o", str(temp / "check")], check=True)
    subprocess.run([str(temp / "check")], check=True)
