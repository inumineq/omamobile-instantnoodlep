#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Host test for tools/instantnoodlep-nopd-trace against fake kernel files.
# No phone. TOOL=<path> selects the tool under test (used for mutation checks).
set -eu
ROOT=$(cd "$(dirname "$0")/.." && pwd)
TOOL=${TOOL:-$ROOT/tools/instantnoodlep-nopd-trace}
T=$(mktemp -d)
trap 'rm -rf "$T"' EXIT
fail() { echo "not ok - $*" >&2; exit 1; }
ok() { echo "ok - $*"; }

setup() {
  rm -rf "$T/out" "$T/udc" "$T/plat"
  mkdir -p "$T/out" "$T/udc/a600000.usb" "$T/plat/a600000.usb/power"
  : >"$T/out/nopd-armed"
  printf 'active\n' >"$T/plat/a600000.usb/power/runtime_status"
  printf 'vdda 1 1\n' >"$T/reg"; : >"$T/deferred"
  printf '%s\n' "$1" >"$T/cmdline"
  printf 'cx on\nusb30_prim_gdsc on\n' >"$T/genpd"
  printf 'gcc_usb30_prim_master_clk 1\n' >"$T/clk"
  printf 'configured\n' >"$T/udc/a600000.usb/state"
  printf 'abcdef0123456789\n' >"$T/bootid"
}
run() {
  rc=0
  out=$(NOPD_TRACE_CMDLINE=$T/cmdline NOPD_TRACE_DIR=$T/out NOPD_TRACE_GENPD=$T/genpd \
        NOPD_TRACE_CLK=$T/clk NOPD_TRACE_UDC=$T/udc NOPD_TRACE_BOOTID=$T/bootid \
        NOPD_TRACE_REG=$T/reg NOPD_TRACE_DEFERRED=$T/deferred NOPD_TRACE_PLAT=$T/plat \
        NOPD_TRACE_MIN_FREE_KB=${MINFREE:-1} \
        sh "$TOOL" "$@" 2>&1) || rc=$?
}
B='console=tty0 clk_ignore_unused androidboot.slot_suffix=_b'
D=$T/out/trace-abcdef01

setup "$B pd_ignore_unused"; run 1 1
[ "$rc" = 1 ] || fail "flag set: rc $rc"
[ "$(ls "$T/out")" = nopd-armed ] || fail "flag set: wrote files or disarmed"
ok "refuses while pd_ignore_unused is set and stays armed"

setup "console=tty0 androidboot.slot_suffix=_b"; run 1 1
[ "$rc" = 1 ] || fail "no flag at all: rc $rc"
[ "$(ls "$T/out")" = nopd-armed ] || fail "no flag at all: wrote files or disarmed"
ok "refuses a command line without clk_ignore_unused"

setup "console=tty0 clk_ignore_unused androidboot.slot_suffix=_a"; run 1 1
[ "$rc" = 2 ] || fail "slot A: rc $rc"
[ "$(ls "$T/out")" = nopd-armed ] || fail "slot A: wrote files or disarmed"
ok "refuses slot A"

setup "$B"
for args in "x" "1 0" "1 x" "1 1 1" "1000000"; do
  # shellcheck disable=SC2086
  run $args
  [ "$rc" = 2 ] || fail "arguments '$args': rc $rc"
done
[ "$(ls "$T/out")" = nopd-armed ] || fail "bad arguments wrote files or disarmed"
ok "bad arguments are refused"

setup "$B"; rm "$T/out/nopd-armed"; run 1 1
[ "$rc" = 1 ] || fail "not armed: rc $rc"
[ -z "$(ls "$T/out")" ] || fail "not armed: wrote files"
ok "refuses when not armed"

setup "$B"; MINFREE=99999999999 run 1 1
[ "$rc" = 1 ] || fail "low space: rc $rc"
ls "$T/out" | grep -q trace- && fail "low space: wrote a trace"
ok "refuses with too little free space"

setup "$B"; run 1 1
[ "$rc" = 0 ] || fail "armed run: rc $rc: $out"
[ ! -e "$T/out/nopd-armed" ] || fail "still armed after a run"
run 1 1
[ "$rc" = 1 ] || fail "second run without arming: rc $rc"
ok "one run per arming"

setup "$B"; touch -d '2 hours ago' "$T/out/nopd-armed"; run 1 1
[ "$rc" = 1 ] || fail "stale arming: rc $rc"
[ -z "$(ls "$T/out")" ] || fail "stale arming: wrote files or stayed armed"
setup "$B"; touch -d '2 hours' "$T/out/nopd-armed"; run 1 1
[ "$rc" = 1 ] || fail "arming far in the future: rc $rc"
ok "an arming more than 30 minutes away is refused and removed"

setup "$B"; rm "$T/genpd"; run 1 1
[ "$rc" = 1 ] || fail "no power-domain summary: rc $rc"
ok "refuses without the power-domain summary"

# A failed wait must not look like a complete trace.
setup "$B"; mkdir -p "$T/bin"; printf '#!/bin/sh\nexit 1\n' >"$T/bin/sleep"; chmod +x "$T/bin/sleep"
PATH=$T/bin:$PATH run 3 1
[ "$rc" = 1 ] || fail "failed wait: rc $rc"
grep -q '^end' "$D/index.txt" && fail "failed wait wrote an end line"
ok "a failed wait is an error and writes no end line"

# The output directory becomes unwritable in the middle of the run.
if [ "$(id -u)" != 0 ]; then
  setup "$B"
  ( sleep 1.5; chmod 500 "$D" ) &
  run 4 1; wait; chmod 700 "$D"
  [ "$rc" = 1 ] || fail "unwritable directory: rc $rc: $out"
  grep -q '^end' "$D/index.txt" && fail "unwritable directory wrote an end line"
  ok "a failed write is an error and writes no end line"
fi

# The USB domain and the gadget go away between two samples.
setup "$B"
( sleep 1.5; printf 'cx on\nusb30_prim_gdsc off-0\n' >"$T/genpd"
  printf 'not attached\n' >"$T/udc/a600000.usb/state" ) &
run 3 1; wait
[ "$rc" = 0 ] || fail "trace: rc $rc: $out"
grep -q '^0 uptime=.* changed: none$' "$D/index.txt" || fail "sample 0: $(cat "$D/index.txt")"
grep -q '^[1-3] uptime=.* changed: genpd usb\( dmesg\)\?$' "$D/index.txt" || fail "no change line: $(cat "$D/index.txt")"
[ "$(grep -c 'changed: genpd' "$D/index.txt")" = 1 ] || fail "change reported twice"
grep -q 'usb30_prim_gdsc on' "$D/genpd.0" || fail "first sample lost"
grep -q 'a600000.usb/state configured' "$D/usb.0" || fail "usb state not stored: $(cat "$D/usb.0")"
grep -q 'power/runtime_status active' "$D/usb.0" || fail "controller runtime status not stored"
grep -q 'vdda' "$D/reg.0" || fail "regulator summary not stored"
[ -s "$D/dmesg.0" ] || fail "kernel log not stored per sample"
grep -q '^end .* samples=[34]$' "$D/index.txt" || fail "no end line: $(cat "$D/index.txt")"
grep -q 'slot_suffix=_b' "$D/cmdline.txt" || fail "no cmdline copy"
ok "samples are stored and the change is reported once"

setup "$B"; rm "$T/clk"; run 1 1
[ "$rc" = 0 ] || fail "missing clk: rc $rc"
[ "$(cat "$D/clk.0")" = UNREADABLE ] || fail "missing clk not marked"
grep -q 'cx on' "$D/genpd.0" || fail "genpd lost when clk is missing"
ok "an unreadable source is marked and the rest continues"
echo "all passed"
