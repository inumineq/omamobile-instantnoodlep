# A stock-like overlay: fragments target labels the base does not define, so
# dtc -@ records them in __fixups__ (stock entry 16 has 156 of these).
# The same board with a PM8150B Type-C port, like the Type-C feature DTBs.
TYPEC_DTS = DTS.replace(
    """            pmic@0 {
                pon@800 {
                    compatible = "qcom,pm8998-pon";
                };
            };""",
    """            pmic@0 {
                pon@800 {
                    compatible = "qcom,pm8998-pon";
                };
            };
            pmic@2 {
                typec@1500 {
                    compatible = "qcom,pm8150b-typec";
                    status = "okay";
                    connector {
                        compatible = "usb-c-connector";
                    };
                };
            };""").replace(
    'dr_mode = "otg";',
    'dr_mode = "otg";\n                role-switch-default-mode = "peripheral";')


OVERLAY_DTS = r'''/dts-v1/;
/plugin/;
&pm8150_gpios { qcom,downstream = "x"; };
&BOB { regulator-min-microvolt = <3008000>; };
&qupv3_se4_i2c { status = "okay"; touch@20 { compatible = "synaptics-s3908"; }; };
'''
OVERLAY_LABELS = ["BOB", "pm8150_gpios", "qupv3_se4_i2c"]
OVERLAY = None


def make_overlay(parent):
    source = parent / "entry16.dts"
    output = parent / "entry16.dtbo"
    source.write_text(OVERLAY_DTS)
    run(["dtc", "-q", "-@", "-I", "dts", "-O", "dtb", "-o", output, source])
    return output


def make_dtb(parent, name="base", text=DTS):
    source = parent / (name + ".dts")
    output = parent / (name + ".dtb")
    source.write_text(text)
    run(["dtc", "-q", "-I", "dts", "-O", "dtb", "-o", output, source])
    return output


def builder_args(kernel, dtb, key, rootfs, boot, out):
    return [
        str(BUILDER),
        "--kernel", kernel,
        "--dtb", dtb,
        "--ssh-key", key,
        "--mkbootimg", MKBOOTIMG,
        "--omarchy-mobile", UPSTREAM,
        "--initramfs-root", rootfs,
        "--stock-overlay", OVERLAY,
        "--boot", boot,
        "--out", out,
    ]


def call_builder(*args, cwd=None):
    return subprocess.run([str(arg) for arg in args], text=True,
                          capture_output=True, cwd=cwd)


def test_cli(work):
    args = [
        BUILDER,
        "--kernel", work / "missing.kernel",
        "--dtb", work / "missing.dtb",
        "--ssh-key", work / "missing.pub",
        "--mkbootimg", work / "mkbootimg.py",
        "--omarchy-mobile", work / "missing-upstream",
        "--initramfs-root", work / "missing-rootfs",
        "--stock-overlay", work / "missing.dtbo",
    ]
    result = call_builder(*args, "--boot", 3, "--out", "invalid.img", cwd=work)
    require(result.returncode != 0 and "--boot must be 1" in result.stderr,
            "CLI did not refuse an invalid boot selector")
    (work / "existing.img").write_bytes(b"do not overwrite")
    result = call_builder(*args, "--boot", 1, "--out", "existing.img", cwd=work)
    require(result.returncode != 0 and "already exists" in result.stderr,
            "CLI did not refuse an existing output")
    require((work / "existing.img").read_bytes() == b"do not overwrite",
            "existing output was changed")
    result = call_builder(*args, "--boot", 1, "--out", "missing.img", cwd=work)
    require(result.returncode != 0 and "--kernel must name a file" in result.stderr,
            "CLI did not refuse a missing input")
    print("ok - CLI refuses boot values, existing outputs and missing inputs")


def test_pure(work):
    patched = probe.patch_init(UPSTREAM.joinpath("initramfs/init").read_text())
    require("modprobe qcom_wdt" in patched, "qcom_wdt was not patched")
    require("watchdog -t 5 -T 30 /dev/watchdog0" in patched,
            "watchdog feeder was not patched")
    raises(probe.BuildError, lambda: probe.patch_init("no anchor\n"),
           "hostname anchor")
    raises(probe.BuildError, lambda: probe.check_image_sizes(0, 1, 1), "non-empty")
    raises(probe.BuildError,
           lambda: probe.check_image_sizes(1, 1, probe.DTB_LOAD_GAP + 1), "DTB")
    raises(probe.BuildError,
           lambda: probe.check_image_sizes(probe.KERNEL_REGION, 1, 1),
           "reserved kernel region")
    payload = b"pretend decompressed Image payload\n" * 1000
    gz = work / "Image.gz"
    gz.write_bytes(gzip.compress(payload))
    require(probe.kernel_image_size(gz) == len(payload),
            "gzip kernel image size is not the decompressed length")
    plain = work / "Image"
    plain.write_bytes(payload)
    require(probe.kernel_image_size(plain) == len(payload),
            "plain kernel image size is not the file size")
    raises(probe.BuildError,
           lambda: probe.check_image_sizes(1, probe.BOOT_IMAGE_MAX, 1),
           "conservative")
    outputs = probe.artifact_paths(Path("out/boot.img"))
    require(outputs["dtb"] == Path("out/boot.probe.dtb"),
            "probe DTB path does not derive from --out")
    require(outputs["ramdisk"] == Path("out/boot.initramfs.cpio.gz"),
            "ramdisk path does not derive from --out")

    original_get, original_cells = probe.fdt_get, probe.fdt_cells
    values = {"qcom,msm-id": probe.MSM_ID, "qcom,board-id": probe.BOARD_ID}
    try:
        # This is fdtget -t s's real one-line, space-separated string format.
        probe.fdt_get = lambda *args: "oneplus,instantnoodlep qcom,sm8250"
        probe.fdt_cells = lambda dtb, node, prop: values[prop]
        probe.require_identity(Path("synthetic.dtb"))
        probe.fdt_get = lambda *args: "wrong,board qcom,sm8250"
        raises(probe.BuildError,
               lambda: probe.require_identity(Path("bad.dtb")), "root compatible")
        probe.fdt_get = lambda *args: "oneplus,instantnoodlep qcom,sm8250"
        values["qcom,msm-id"] = [0x164]
        raises(probe.BuildError,
               lambda: probe.require_identity(Path("bad.dtb")), "qcom,msm-id")
        values["qcom,msm-id"] = probe.MSM_ID
        values["qcom,board-id"] = [8, 0, 0, 1]
        raises(probe.BuildError,
               lambda: probe.require_identity(Path("bad.dtb")), "qcom,board-id")
    finally:
        probe.fdt_get, probe.fdt_cells = original_get, original_cells
    print("ok - identity, watchdog, size guards and output naming")


def test_initramfs(work, private, public):
    raises(probe.BuildError, lambda: probe.validate_public_key(private),
           "PUBLIC key")
    probe.validate_public_key(public)
    rootfs = make_rootfs(work)
    first = work / "first.cpio.gz"
    second = work / "second.cpio.gz"
    shared_init = UPSTREAM / "initramfs/init"
    probe.build_initramfs(rootfs, shared_init, public, first, work / "one")
    (work / "two").mkdir()
    probe.build_initramfs(rootfs, shared_init, public, second, work / "two")
    names = probe.cpio_names(first)
    require(probe.ALLOWLIST not in names, "write allowlist survived packing")
    require("etc/omamobile-ufs-rw-luns" not in names, "LUN allowlist survived")
    require("etc/omamobile-nfsroot" not in names, "NFS root request survived")
    require("etc/omamobile-simplefb-trig" not in names,
            "display register-write marker survived")
    require("etc/omamobile-bringup-probe" not in names,
            "bring-up register-read marker survived")
    require("root/.ssh/authorized_keys" in names, "public key is absent")
    require("init" in names, "shared init is absent")
    run(["sh", "-n", work / "one/rootfs/init"])
    require(probe.sha256(first) == probe.sha256(second),
            "initramfs packing is not reproducible")
    print("ok - no allowlist, local key, watchdog init and reproducible gzip cpio")


def test_aosp(work):
    kernel = work / "Image.dummy"
    ramdisk = work / "initramfs.cpio.gz"
    dtb = work / "dummy.dtb"
    kernel.write_bytes(b"dummy kernel, not executed\n")
    dtb.write_bytes(b"\xd0\x0d\xfe\xed synthetic DTB placeholder")
    root = work / "archive-root"
    (root / "etc").mkdir(parents=True)
    (root / "etc/marker").write_text("no allowlist\n")
    probe.pack_rootfs(root, ramdisk)
    boot = work / "boot.img"
    probe.pack_boot(MKBOOTIMG, kernel, ramdisk, dtb, boot)
    info, unpacked = probe.read_back_boot(
        boot, MKBOOTIMG, kernel, ramdisk, dtb, work / "verify")
    require(info["boot image header version"] == "2", "header is not v2")
    require(info["dtb address"] == "0x0000000001f00000", "wrong DTB address")
    require((unpacked / "dtb").read_bytes() == dtb.read_bytes(),
            "read-back DTB differs")
    damaged = work / "damaged.img"
    image = bytearray(boot.read_bytes())
    image[40:44] = (1).to_bytes(4, "little")
    damaged.write_bytes(image)
    raises(probe.BuildError,
           lambda: probe.read_back_boot(
               damaged, MKBOOTIMG, kernel, ramdisk, dtb, work / "damaged"),
           "header")
    (root / "etc/omamobile-ufs-rw").write_text("boot_b\n")
    probe.pack_rootfs(root, ramdisk)
    raises(probe.BuildError, lambda: probe.assert_no_allowlist(ramdisk),
           "allowlist")
    print("ok - AOSP v2 geometry, payload read-back, header and allowlist refusals")


def check_summaries(out):
    paths = probe.artifact_paths(out)
    manifest = json.loads(paths["manifest"].read_text())
    require(manifest["hardware_boot_tested"] is False,
            "manifest claims hardware testing")
    require(manifest["boot_image_limit"]["evidence"].startswith("[I]"),
            "size cap lacks [I] evidence")
    require(manifest["header"]["boot image header version"] == "2",
            "manifest header is not v2")
    require(manifest["header"]["second bootloader load address"] ==
            "0x00000000", "second address is not zero")
    require(manifest["header"]["kernel load address"] == "0x00008000",
            "kernel address is not the stock geometry")
    require(manifest["header"]["ramdisk load address"] == "0x01000000",
            "ramdisk address is not the stock geometry")
    require(manifest["header"]["kernel tags load address"] == "0x00000100",
            "tags address is not the stock geometry")
    lines = paths["sums"].read_text().splitlines()
    require(len(lines) == 4, "SHA256SUMS does not cover all four artifacts")
    covered = set()
    for line in lines:
        digest, filename = line.split("  ", 1)
        covered.add(filename)
        require(probe.sha256(out.parent / filename) == digest,
                f"wrong sha256 for {filename}")
    require(covered == {path.name for key, path in paths.items() if key != "sums"},
            "an output is missing from SHA256SUMS")
    require(probe.ALLOWLIST not in probe.cpio_names(paths["ramdisk"]),
            "read-back initramfs contains an allowlist")


def test_full(work, private, public):
    def call(*args):
        return call_builder(*args, cwd=work)

    kernel = work / "Image.dummy"
    kernel.write_bytes(b"dummy kernel, not executed\n")
    global OVERLAY
    OVERLAY = make_overlay(work)
    require(probe.overlay_labels(OVERLAY) == OVERLAY_LABELS,
            "overlay labels were not read from __fixups__")
    dtb = make_dtb(work)
    original_hash = probe.sha256(dtb)
    rootfs = make_rootfs(work / "input")
    outdir = work / "output"
    outdir.mkdir()
    built = {}
    for boot in (1, 2):
        out = Path(f"output/boot{boot}.img")
        result = call(*builder_args(
            kernel, dtb, public, rootfs, boot, out))
        require(result.returncode == 0,
                f"boot {boot} builder failed: {result.stderr}\n{result.stdout}")
        require(result.stdout == f"fastboot -s <serial> boot {out}\n",
                f"unexpected final output: {result.stdout!r}")
        require("flash" not in result.stdout.lower() and
                "erase" not in result.stdout.lower() and
                "set-active" not in result.stdout.lower(),
                "output contains a persistent-write command")
        paths = probe.artifact_paths(work / out)
        built[boot] = paths
        check_summaries(work / out)
        require(probe.fdt_get(paths["dtb"], probe.USB_NODE, "dr_mode") ==
                "peripheral", "USB is not peripheral")
        require(not probe.property_present(paths["dtb"], probe.USB_NODE,
                                          "usb-role-switch"),
                "USB role switch survived")
        remotes = probe.remoteproc_nodes(paths["dtb"])
        require(len(remotes) == 2, "synthetic remoteproc nodes were not found")
        for node in remotes:
            require(probe.fdt_get(paths["dtb"], node, "status") == "disabled",
                    f"remoteproc remains enabled: {node}")
        expected = "disabled" if boot == 1 else "okay"
        require(probe.fdt_get(paths["dtb"], probe.UFS_NODE, "status") == expected,
                f"boot {boot} UFS status is not {expected}")
        probe.verify_probe_dtb(paths["dtb"], boot, OVERLAY_LABELS)
        require(probe.fdt_cells(paths["dtb"], "/", "oplus,dtsi_no") == [0x4D63],
                "oplus,dtsi_no missing")
        require(probe.fdt_cells(paths["dtb"], probe.PON_NODE,
                                "mode-bootloader") == [2] and
                probe.fdt_cells(paths["dtb"], probe.PON_NODE,
                                "mode-recovery") == [1],
                "pon reboot modes missing")
        handles = [probe.fdt_cells(paths["dtb"], f"{probe.SINK}/{label}",
                                   "phandle")[0] for label in OVERLAY_LABELS]
        require(len(set(handles)) == len(handles) and
                not set(handles) & probe.fdt_phandles(dtb),
                "sink phandles collide")
        merged = work / f"merged{boot}.dtb"
        run(["fdtoverlay", "-i", paths["dtb"], "-o", merged, OVERLAY])
        require(probe.fdt_get(merged, f"{probe.SINK}/qupv3_se4_i2c/touch@20",
                              "compatible") == "synaptics-s3908",
                "overlay fragment did not land in the sink")
        require(probe.fdt_get(merged, probe.UFS_NODE, "status") == expected,
                "overlay changed a real node")
    require(probe.sha256(dtb) == original_hash, "builder modified the input DTB")
    require(probe.sha256(built[1]["ramdisk"]) == probe.sha256(built[2]["ramdisk"]),
            "boot selector changed the initramfs")

    result = call(*builder_args(
        kernel, dtb, public, rootfs, 1, "output/boot1.img"))
    require(result.returncode != 0 and "already exists" in result.stderr,
            "existing output was not refused")
    result = call(*builder_args(
        kernel, dtb, public, rootfs, 3, "output/invalid-boot.img"))
    require(result.returncode != 0 and "--boot must be 1" in result.stderr,
            "invalid boot selector was not refused")
    result = call(*builder_args(
        kernel, dtb, private, rootfs, 1, "output/private-key.img"))
    require(result.returncode != 0 and "PUBLIC key" in result.stderr,
            "private key was not refused")

    variants = {
        "compatible": (DTS.replace("oneplus,instantnoodlep", "wrong,board"),
                       "root compatible"),
        "msm-id": (DTS.replace("0x164 0x20001", "0x164 0x20002"),
                   "qcom,msm-id"),
        "board-id": (DTS.replace("0x08 0x00", "0x09 0x00"),
                     "qcom,board-id"),
    }
    for name, (text, error) in variants.items():
        bad = make_dtb(work, name, text)
        out = f"output/refuse-{name}.img"
        result = call(*builder_args(kernel, bad, public, rootfs, 1, out))
        require(result.returncode != 0 and error in result.stderr,
                f"{name} mismatch was not refused: {result.stderr}")
        require(not (work / out).exists(), f"refused {name} left an image")

    oversized = work / "oversized.kernel"
    with oversized.open("wb") as stream:
        stream.truncate(probe.KERNEL_REGION)
    result = call(*builder_args(
        oversized, dtb, public, rootfs, 1, "output/oversized.img"))
    require(result.returncode != 0 and "reserved kernel region" in result.stderr,
            "oversized kernel was not refused")
    require(not (work / "output/oversized.img").exists(),
            "size refusal left an image")
    # Tethered M2 (--root userdata): allowlist exactly userdata, no
    # omamobile.initramfs on the command line, boot 2 only.
    out = Path("output/tethered.img")
    result = call(*builder_args(kernel, dtb, public, rootfs, 2, out),
                  "--root", "userdata")
    require(result.returncode == 0, f"tethered build failed: {result.stderr}")
    paths = probe.artifact_paths(work / out)
    probe.assert_allowlist(paths["ramdisk"], "userdata")
    require(probe.cpio_file(paths["ramdisk"], probe.ALLOWLIST).decode().split()
            == ["userdata"], "tethered allowlist is not exactly userdata")
    manifest = json.loads(paths["manifest"].read_text())
    cmdline = manifest["header"]["command line args"]
    require("omamobile.initramfs" not in cmdline and
            "systemd.watchdog_sec=20" in cmdline,
            f"tethered cmdline wrong: {cmdline}")
    require(manifest["root"] == "userdata", "manifest lacks root mode")
    require("systemd.debug_shell" not in cmdline and
            manifest["debug_shell"] is False,
            "debug shell is on without --debug-shell")
    out = Path("output/tethered-debug.img")
    result = call(*builder_args(kernel, dtb, public, rootfs, 2, out),
                  "--root", "userdata", "--debug-shell")
    require(result.returncode == 0, f"debug build failed: {result.stderr}")
    manifest = json.loads(probe.artifact_paths(work / out)["manifest"].read_text())
    require(manifest["header"]["command line args"].endswith(
                "systemd.watchdog_sec=20 systemd.debug_shell=ttyGS0") and
            manifest["debug_shell"] is True,
            f"debug cmdline wrong: {manifest['header']['command line args']}")
    result = call(*builder_args(kernel, dtb, public, rootfs, 2,
                                "output/debug-no-root.img"), "--debug-shell")
    require(result.returncode != 0 and "--debug-shell needs --root userdata"
            in result.stderr, "debug shell without a root was not refused")
    raises(probe.BuildError,
           lambda: probe.assert_allowlist(built[2]["ramdisk"], "userdata"),
           "lacks /etc/omamobile-ufs-rw")
    raises(probe.BuildError,
           lambda: probe.assert_allowlist(paths["ramdisk"], "none"),
           "allowlist")
    result = call(*builder_args(kernel, dtb, public, rootfs, 1,
                                "output/tethered-boot1.img"),
                  "--root", "userdata")
    require(result.returncode != 0 and "needs --boot 2" in result.stderr,
            "tethered with UFS off was not refused")
    print("ok - generated-DTB refusals, boot 1 and 2, tethered root, edits, headers and sha256")


def test_typec(work, private, public):
    kernel = work / "Image.dummy"
    kernel.write_bytes(b"dummy kernel, not executed\n")
    global OVERLAY
    OVERLAY = make_overlay(work)
    rootfs = make_rootfs(work / "input")
    typec_dtb = make_dtb(work, "typec", TYPEC_DTS)
    plain_dtb = make_dtb(work, "plain", DTS)

    out = Path("output/typec.img")
    result = call_builder(*builder_args(kernel, typec_dtb, public, rootfs, 2, out),
                          "--typec", cwd=work)
    require(result.returncode == 0, f"--typec build failed: {result.stderr}")
    paths = probe.artifact_paths(work / out)
    require(probe.fdt_get(paths["dtb"], probe.USB_NODE, "dr_mode") == "otg",
            "--typec did not keep dr_mode otg")
    require(probe.property_present(paths["dtb"], probe.USB_NODE, "usb-role-switch"),
            "--typec dropped the role switch")
    require(probe.fdt_get(paths["dtb"], probe.USB_NODE, "role-switch-default-mode")
            == "peripheral", "--typec default role is not peripheral")
    require(probe.fdt_get(paths["dtb"], probe.TYPEC_NODE, "status") == "okay",
            "--typec lost the Type-C port")
    probe.verify_probe_dtb(paths["dtb"], 2, OVERLAY_LABELS, typec=True)

    out = Path("output/typec-forced.img")
    result = call_builder(*builder_args(kernel, typec_dtb, public, rootfs, 2, out),
                          cwd=work)
    require(result.returncode == 0, f"plain build failed: {result.stderr}")
    paths = probe.artifact_paths(work / out)
    require(probe.fdt_get(paths["dtb"], probe.USB_NODE, "dr_mode") == "peripheral",
            "plain build did not force peripheral")
    require(not probe.property_present(paths["dtb"], probe.USB_NODE,
                                       "usb-role-switch"),
            "plain build kept the role switch")

    result = call_builder(*builder_args(kernel, plain_dtb, public, rootfs, 2,
                                         "output/typec-refused.img"),
                          "--typec", cwd=work)
    require(result.returncode != 0 and "--typec needs the PM8150B Type-C port"
            in result.stderr,
            f"--typec without a port was not refused: {result.stderr}")
    peripheral_dtb = make_dtb(work, "peripheral", TYPEC_DTS.replace(
        'dr_mode = "otg";', 'dr_mode = "peripheral";'))
    result = call_builder(*builder_args(kernel, peripheral_dtb, public, rootfs, 2,
                                         "output/typec-refused2.img"),
                          "--typec", cwd=work)
    require(result.returncode != 0 and "--typec needs USB dr_mode otg"
            in result.stderr,
            f"--typec on a peripheral DTB was not refused: {result.stderr}")
    require(not (work / "output/typec-refused.img").exists(),
            "refused --typec left an image")
    print("ok - --typec keeps and verifies the Type-C graph")


def test_keep_remoteproc(work, private, public):
    kernel = work / "Image.dummy"
    kernel.write_bytes(b"dummy kernel, not executed\n")
    global OVERLAY
    OVERLAY = make_overlay(work)
    rootfs = make_rootfs(work / "input")
    dtb = make_dtb(work, "plain", DTS)

    out = Path("output/keep.img")
    result = call_builder(*builder_args(kernel, dtb, public, rootfs, 2, out),
                          "--keep-remoteproc", "4080000", cwd=work)
    require(result.returncode == 0, f"--keep-remoteproc build failed: {result.stderr}")
    paths = probe.artifact_paths(work / out)
    remotes = probe.remoteproc_nodes(paths["dtb"])
    kept = [n for n in remotes if n.endswith("@4080000")]
    require(len(kept) == 1 and probe.fdt_get(paths["dtb"], kept[0], "status") == "okay",
            "--keep-remoteproc did not keep the named node okay")
    for node in remotes:
        if node not in kept:
            require(probe.fdt_get(paths["dtb"], node, "status") == "disabled",
                    f"--keep-remoteproc left another remoteproc enabled: {node}")
    probe.verify_probe_dtb(paths["dtb"], 2, OVERLAY_LABELS, keep=("4080000",))

    result = call_builder(*builder_args(kernel, dtb, public, rootfs, 2,
                                         "output/keep-refused.img"),
                          "--keep-remoteproc", "1234", cwd=work)
    require(result.returncode != 0 and "names no remoteproc node" in result.stderr,
            f"unknown --keep-remoteproc was not refused: {result.stderr}")
    require(not (work / "output/keep-refused.img").exists(),
            "refused --keep-remoteproc left an image")
    print("ok - --keep-remoteproc keeps one remote processor and disables the rest")


def main():
    with tempfile.TemporaryDirectory(prefix="instantnoodlep-probe-test-") as temp:
        work = Path(temp)
        cli = work / "cli"
        cli.mkdir()
        test_cli(cli)
        pure = work / "pure"
        pure.mkdir()
        if UPSTREAM.joinpath("initramfs/init").is_file():
            test_pure(pure)
        else:
            skip("pure patch checks", "set OMAMOBILE to an upstream checkout")

        key = None
        if shutil.which("ssh-keygen"):
            key = make_key(work)
        else:
            skip("throwaway SSH key generation", "ssh-keygen is missing")

        tools = missing_tools("bash", "cpio", "find", "gzip", "sort")
        if key and not tools and UPSTREAM.joinpath("initramfs/init").is_file():
            init_work = work / "initramfs"
            init_work.mkdir()
            (init_work / "one").mkdir()
            test_initramfs(init_work, *key)
        else:
            reasons = []
            if not key:
                reasons.append("no throwaway key")
            if tools:
                reasons.append("missing " + ", ".join(tools))
            if not UPSTREAM.joinpath("initramfs/init").is_file():
                reasons.append("set OMAMOBILE")
            skip("initramfs build and refusal checks", "; ".join(reasons))

        if MKBOOTIMG and MKBOOTIMG.is_file() and \
                MKBOOTIMG.with_name("unpack_bootimg.py").is_file() and not tools:
            aosp = work / "aosp"
            aosp.mkdir()
            test_aosp(aosp)
        else:
            skip("AOSP header and cpio read-back checks",
                 "set MKBOOTIMG beside unpack_bootimg.py; cpio tools are required")

        dt_tools = missing_tools("dtc", "fdtget", "fdtput")
        if key and not tools and not dt_tools and MKBOOTIMG and MKBOOTIMG.is_file() \
                and UPSTREAM.joinpath("initramfs/init").is_file():
            full = work / "full"
            full.mkdir()
            test_full(full, *key)
            typec_work = work / "typec"
            typec_work.mkdir()
            test_typec(typec_work, *key)
            keep_work = work / "keep"
            keep_work.mkdir()
            test_keep_remoteproc(keep_work, *key)
        else:
            reasons = []
            if dt_tools:
                reasons.append("missing " + ", ".join(dt_tools))
            if not key or tools or not MKBOOTIMG or not MKBOOTIMG.is_file():
                reasons.append("key/cpio/AOSP prerequisites are incomplete")
            if not UPSTREAM.joinpath("initramfs/init").is_file():
                reasons.append("set OMAMOBILE")
            skip("generated-DTB refusals and both happy paths", "; ".join(reasons))
    print(f"ok - host test finished ({skipped} skipped part(s))")
    return 0


if __name__ == "__main__":
    sys.exit(main())
