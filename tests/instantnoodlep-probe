"""Host-only tests for tools/build-instantnoodlep-probe.

No test uses a phone, network, real kernel, Docker or firmware. Set OMAMOBILE
to an existing derekross/omarchy-mobile checkout and MKBOOTIMG to an existing
AOSP mkbootimg.py. SRC_DIR is also honoured for the AOSP tools checkout. Parts
whose prerequisites are absent print SKIP; dtc, fdtget and fdtput are needed
for the generated-DTB refusals and the two end-to-end happy paths.
"""

import gzip
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile

sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parent.parent
BUILDER = ROOT / "tools/build-instantnoodlep-probe"
UPSTREAM = Path(os.environ.get("OMAMOBILE", ROOT.parent / "omarchy-mobile"))
MKBOOTIMG = Path(os.environ["MKBOOTIMG"]) if os.environ.get("MKBOOTIMG") else None
if MKBOOTIMG is None and os.environ.get("SRC_DIR"):
    MKBOOTIMG = Path(os.environ["SRC_DIR"]) / "system/tools/mkbootimg/mkbootimg.py"

loader = importlib.machinery.SourceFileLoader("instantnoodlep_probe", str(BUILDER))
spec = importlib.util.spec_from_loader(loader.name, loader)
probe = importlib.util.module_from_spec(spec)
loader.exec_module(probe)

skipped = 0


def require(condition, message):
    if not condition:
        raise AssertionError(message)


def raises(exception, function, contains=""):
    try:
        function()
    except exception as error:
        if contains:
            require(contains in str(error),
                    f"{contains!r} not in error {str(error)!r}")
        return
    raise AssertionError(f"expected {exception.__name__}: {contains}")


def run(args, **kwargs):
    return subprocess.run([str(arg) for arg in args], check=True, **kwargs)


def skip(name, reason):
    global skipped
    skipped += 1
    print(f"SKIP - {name}: {reason}")


def make_rootfs(parent):
    root = parent / "rootfs"
    (root / "bin").mkdir(parents=True)
    (root / "usr/sbin").mkdir(parents=True)
    (root / "etc").mkdir(parents=True)
    (root / "bin/busybox").write_text("synthetic aarch64 BusyBox\n")
    (root / "usr/sbin/dropbear").write_text("synthetic aarch64 Dropbear\n")
    (root / "sbin").mkdir(exist_ok=True)
    for tool in ("sbin/e2fsck", "usr/sbin/dumpe2fs", "usr/sbin/resize2fs"):
        (root / tool).write_text("synthetic aarch64 e2fsprogs\n")
    # A probe must remove every inherited write request, even a malformed one.
    (root / "etc/omamobile-ufs-rw").write_text("boot_b userdata\n")
    (root / "etc/omamobile-ufs-rw-luns").write_text("sdb\n")
    (root / "etc/omamobile-nfsroot").write_text("192.0.2.1:/probe\n")
    (root / "etc/omamobile-simplefb-trig").write_text("0x0 0x0\n")
    (root / "etc/omamobile-bringup-probe").write_text("\n")
    return root


def make_key(parent):
    private = parent / "throwaway_ed25519"
    run(["ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-f", private])
    return private, private.with_suffix(".pub")


def missing_tools(*names):
    return [name for name in names if shutil.which(name) is None]


