# SPDX-License-Identifier: MIT
# Installed by docs/runbooks/NOPD-TRACE-RUNBOOK.md and removed by its rollback.
# The condition keeps it idle on the daily kernel. The trace tool runs once
# per arming file and exits non-zero on every refusal, and then systemd does
# not run the sleep step after it.
[Unit]
Description=Trace power domains on a kernel without pd_ignore_unused
ConditionKernelCommandLine=!pd_ignore_unused
After=multi-user.target

[Service]
Type=oneshot
ExecStartPre=-/usr/bin/modprobe -a rtc-pm8xxx qcom_stats
ExecStart=/var/lib/s2idle/nopd-trace 240 10
ExecStart=/var/lib/s2idle/step R4d none 60

[Install]
WantedBy=multi-user.target
