#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""Build a RAM-only OnePlus 8 Pro probe without contacting a phone.

Usage: tools/build-instantnoodlep-probe --kernel Image.gz --dtb board.dtb \
         --ssh-key ~/.ssh/id_ed25519.pub --mkbootimg /path/to/mkbootimg.py \
         --omarchy-mobile /path/to/omarchy-mobile \
         --initramfs-root /path/to/aarch64-alpine-root \
         --stock-overlay dtbo-entry16.dtbo --boot 1 --out out/boot.img

-initramfs-root is a prepared, offline aarch64 Alpine root with BusyBox,
Dropbear, cryptsetup, iproute2, util-linux and kmod, plus qcom_wdt matching
the kernel. `--luks2` requires the phone-generated Dropbear host key imported
under etc/dropbear by prepare-initramfs-root.sh; key material stays outside
the repository and is included only in the private boot image artifact.
The builder executes none of its aarch64 binaries. It overlays the shared
initramfs/init from --omarchy-mobile, adds only the supplied public key and
RAM-probe settings, and packs with the host cpio and gzip. This follows the
structure of upstream's flame and dipper probe builders without Docker or
network access. mkbootimg.py and its sibling unpack_bootimg.py come from AOSP
system/tools/mkbootimg. dtc's fdtget/fdtput tools must be on PATH.

--stock-overlay is the dtbo entry stock ABL applies on this unit (entry 16 of
the owner's factory dtbo.img, extracted with mkdtboimg.py; never committed).
ABL refuses a RAM boot whose DTB the overlay cannot apply to, and it picks
the base DTB by oplus,dtsi_no. So the probe DTB gets oplus,dtsi_no and
oplus,pcb_range as in stock, plus an "overlay sink": a __symbols__ table
that points every label the overlay needs at a disabled dummy node under
/__ovl_sink__ (no compatible, so nothing there is populated). No fragment
touches a real node. Verified on the phone 2026-11-16 (NOTES).
--ufdt-apply optionally names AOSP libufdt's ufdt_apply_overlay to check
offline that the overlay applies.

--root userdata (STORAGE-M2-PLAN 3a, tethered M2; needs --boot 2) drops
omamobile.initramfs from the command line so the shared init hands over to
Arch on userdata, packs /etc/omamobile-ufs-rw = userdata and
/etc/omamobile-root-label = omamobile-root, and adds systemd.watchdog_sec=20.
It is still a RAM boot; the tool never writes the phone.

--boot 1 disables the UFS host. --boot 2 enables it. Both disable every
remoteproc node and force USB peripheral mode without a role switch. The
initramfs never contains /etc/omamobile-ufs-rw, so there is no write allowlist.

The 64 MiB image cap is [I], a conservative limit until stage 0 records the
IN2023 boot partition size. It is not a measured device limit. The separate
kernel/DTB size check follows the ABL load model in
docs/research/abl-kernel-size.md (Q/ BootLinux.c) and
device/instantnoodlep/BRINGUP-M1-PLAN.md 5.2.
For OUT.img, the other outputs are OUT.probe.dtb, OUT.initramfs.cpio.gz,
OUT.manifest.json and OUT.SHA256SUMS. Existing outputs are never overwritten.
The last stdout line is a RAM-boot command template; this tool never runs it.
"""

import argparse
import base64
import hashlib
import json
import os
from pathlib import Path
import posixpath
import shutil
import struct
import subprocess
import sys
import tempfile

PAGE = 4096
BASE = 0x00000000
KERNEL_OFF = 0x00008000
RAMDISK_OFF = 0x01000000
SECOND_OFF = 0x00000000
TAGS_OFF = 0x00000100
DTB_OFF = 0x01F00000
HEADER_VERSION = 2
CMDLINE = ("console=tty0 panic=10 omamobile.initramfs clk_ignore_unused "
           "pd_ignore_unused printk.devkmsg=on")
# --root userdata (STORAGE-M2-PLAN 3a, tethered M2): no omamobile.initramfs,
# so the shared init hands over to Arch on userdata; systemd must take over
# the hardware watchdog the busybox feeder armed (30 s) once it is killed.
ROOT_CMDLINE = ("console=tty0 panic=10 clk_ignore_unused pd_ignore_unused "
                "printk.devkmsg=on systemd.watchdog_sec=20")
# --debug-shell (BRINGUP-M1b-PLAN 4): systemd's debug shell on the USB
# serial port, a root shell before sshd.
DEBUG_SHELL = "systemd.debug_shell=ttyGS0"
ROOT_ALLOWLIST = "userdata"
ROOT_LABEL = "omamobile-root"
BOOT_IMAGE_MAX = 64 * 1024 * 1024
SIZE_LIMIT_EVIDENCE = "[I] conservative cap; IN2023 boot partition size is not measured"
# Q's ABL places the DTB 2 MiB + one page below the ramdisk (DT_SIZE_2MB +
# page, Q/BootLinux.c:207-209) and rejects a larger post-overlay DTB
# (Q/BootLinux.c:400-405).
DTB_LOAD_GAP = 2 * 1024 * 1024 + PAGE
# Q's ABL never reads the header's addr fields; it computes load addresses
# from the reserved kernel region (Q/BootLinux.c:141-217,876-879) with PCD
# defaults KernelLoadAddress 0x00080000 and RamdiskEndAddress 0x05600000
# (QcomModulePkg.dec:157,160). OnePlus's fork values are [I], but the
# community 7.2.0 kernel (49,020,928 bytes decompressed) boots, so its
# region is far above the old 16 MiB header gap. See
# docs/research/abl-kernel-size.md.
KERNEL_REGION = 0x05600000 - 0x00080000
USB_NODE = "/soc@0/usb@a6f8800/usb@a600000"
UFS_NODE = "/soc@0/ufshc@1d84000"
# PM8150 PON: reboot-mode magics so `reboot bootloader` lands in fastboot
# instead of passing through stock (BRINGUP-M1b-PLAN 4). The values are
# mainline pm8998.dtsi's; [I] on this ABL until M1b B1.
PON_NODE = "/soc@0/spmi@c440000/pmic@0/pon@800"
PON_MODES = {"mode-bootloader": 0x2, "mode-recovery": 0x1}
COMPATIBLE = ["oneplus,instantnoodlep", "qcom,sm8250"]
MSM_ID = [0x164, 0x10000, 0x164, 0x20001]
BOARD_ID = [0x08, 0x00, 0x00, 0x00]
ALLOWLIST = "etc/omamobile-ufs-rw"
# Stock base-DTB selectors for project 19811 (R4 note, stock boot DTB 3).
OPLUS_DTSI_NO = [0x4D63]
OPLUS_PCB_RANGE = [0x0, 0x38]
SINK = "/__ovl_sink__"
SYMBOLS = "/__symbols__"


class BuildError(Exception):
    """An input or constructed artifact failed a required gate."""


def run(args, *, cwd=None, data=None):
    result = subprocess.run(
        [str(a) for a in args], cwd=cwd, input=data,
        stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if result.returncode:
        detail = (result.stderr or result.stdout).decode(
            "utf-8", "replace").strip()
        raise BuildError(f"{Path(str(args[0])).name} failed: {detail}")
    return result.stdout


def sha256(path):
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for block in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def validate_public_key(path):
    try:
        lines = path.read_text().strip().splitlines()
    except UnicodeError as error:
        raise BuildError("--ssh-key must be an OpenSSH PUBLIC key") from error
    if len(lines) != 1:
        raise BuildError("--ssh-key must contain exactly one OpenSSH PUBLIC key")
    fields = lines[0].split()
    kinds = ("ssh-ed25519", "ssh-rsa", "ecdsa-sha2-nistp256")
    if len(fields) < 2 or fields[0] not in kinds:
        raise BuildError("--ssh-key must be an OpenSSH PUBLIC key, never a private key")
    try:
        raw = base64.b64decode(fields[1], validate=True)
        size = struct.unpack(">I", raw[:4])[0]
        if raw[4:4 + size].decode() != fields[0]:
            raise ValueError("key type does not match its blob")
    except (ValueError, struct.error, UnicodeError) as error:
        raise BuildError("invalid SSH public key") from error


def patch_init(text, *, luks2=False, persistent_host_key=False):
    """Patch the shared init for the watchdog and optional LUKS2 root."""
    anchor = "hostname omamobile\n"
    replacement = """# SM8250's watchdog keeps running until a driver claims it.
modprobe qcom_wdt || echo "omamobile: qcom watchdog module failed" >/dev/kmsg
if [ -c /dev/watchdog0 ]; then
  watchdog -t 5 -T 30 /dev/watchdog0
fi
hostname omamobile
"""
    if text.count(anchor) != 1:
        raise BuildError("shared init changed: hostname anchor is not unique")
    patched = text.replace(anchor, replacement)
    if patched.count("modprobe qcom_wdt") != 1 or \
            patched.count("watchdog -t 5 -T 30 /dev/watchdog0") != 1:
        raise BuildError("watchdog patch did not apply exactly once")
    if persistent_host_key:
        dropbear = 'dropbear -R -E -p 22 2>/dev/null && say "ssh: root@172.16.42.1"'
        static_dropbear = ('dropbear -E -p 22 -r '
                           '/etc/dropbear/dropbear_ed25519_host_key '
                           '2>/dev/null && say "ssh: root@172.16.42.1"')
        if patched.count(dropbear) != 1:
            raise BuildError("shared init changed: dropbear launch anchor is not unique")
        patched = patched.replace(dropbear, static_dropbear)
    if luks2:
        part_anchor = '  [ -n "$dev" ] || { say "arch: no userdata partition"; return 1; }\n'
        cryptroot = part_anchor + '''  if [ -e /etc/omamobile-root-luks2 ]; then
    cryptsetup isLuks --type luks2 "$dev" || {
      say "arch: userdata is not LUKS2; staying in the initramfs"; return 1;
    }
    local rawdev="$dev" mapper=/dev/mapper/omamobile-root status i=0
    if [ ! -b "$mapper" ]; then
      say "arch: encrypted userdata; run cryptroot-unlock over USB SSH"
      while [ "$i" -lt 1800 ] && [ ! -b "$mapper" ]; do
        sleep 1; i=$((i + 1))
      done
    fi
    [ -b "$mapper" ] || {
      say "arch: encrypted root was not unlocked; staying in the initramfs"; return 1;
    }
    status=$(cryptsetup status omamobile-root) || {
      say "arch: cannot verify the root mapping; staying in the initramfs"; return 1;
    }
    echo "$status" | grep -F "device: $rawdev" >/dev/null || {
      say "arch: root mapping is not backed by userdata; staying in the initramfs"; return 1;
    }
    dev="$mapper"
  fi
'''
        if patched.count(part_anchor) != 1:
            raise BuildError("shared init changed: userdata partition anchor is not unique")
        patched = patched.replace(part_anchor, cryptroot)
    return patched


def remove_file(path):
    if path.is_dir() and not path.is_symlink():
        raise BuildError(f"expected a file, found a directory: {path}")
    if path.exists() or path.is_symlink():
        path.unlink()


def pack_rootfs(stage, output):
    # Match dipper's sorted, owner-normalized, timestamp-stable newc archive.
    for path in list(stage.rglob("*")) + [stage]:
        os.utime(path, (0, 0), follow_symlinks=False)
    command = (
        "set -euo pipefail; "
        "find . -print0 | sort -z | "
        "cpio --null --quiet -o -H newc --owner=0:0 --reproducible | "
        "gzip -n -9")
    with output.open("wb") as stream:
        result = subprocess.run(
            ["bash", "-c", command], cwd=stage,
            stdout=stream, stderr=subprocess.PIPE)
    if result.returncode:
        output.unlink(missing_ok=True)
        raise BuildError("cpio failed: " + result.stderr.decode(
            "utf-8", "replace").strip())


def cpio_names(ramdisk):
    import gzip
    try:
        archive = gzip.decompress(ramdisk.read_bytes())
    except (OSError, EOFError) as error:
        raise BuildError("initramfs is not a valid gzip cpio archive") from error
    output = run(["cpio", "-it", "--quiet"], data=archive)
    names = []
    for line in output.decode("utf-8", "replace").splitlines():
        name = posixpath.normpath(line).lstrip("/")
        names.append(name)
    return names


def assert_no_allowlist(ramdisk):
    if ALLOWLIST in cpio_names(ramdisk):
        raise BuildError("write allowlist /etc/omamobile-ufs-rw is present in the written initramfs")


def cpio_file(ramdisk, name):
    import gzip
    archive = gzip.decompress(ramdisk.read_bytes())
    for pattern in (name, "./" + name):
        data = run(["cpio", "-i", "--to-stdout", "--quiet", pattern],
                   data=archive)
        if data:
            return data
    raise BuildError(f"/{name} is missing or empty in the initramfs")


def assert_allowlist(ramdisk, root):
    """--root none: no allowlist at all. --root userdata: exactly userdata."""
    if root == "none":
        assert_no_allowlist(ramdisk)
        return
    names = cpio_names(ramdisk)
    if ALLOWLIST not in names:
        raise BuildError("--root userdata image lacks /etc/omamobile-ufs-rw")
    if cpio_file(ramdisk, ALLOWLIST).decode().split() != [ROOT_ALLOWLIST]:
        raise BuildError("allowlist must be exactly 'userdata'")
    if cpio_file(ramdisk, "etc/omamobile-root-label").decode().strip() != ROOT_LABEL:
        raise BuildError("root-label policy must be omamobile-root")
    for extra in ("etc/omamobile-ufs-rw-luns", "etc/omamobile-root-mode",
                  "etc/omamobile-nfsroot"):
        if extra in names:
            raise BuildError(f"--root userdata image must not contain /{extra}")


def assert_luksroot(ramdisk):
    names = cpio_names(ramdisk)
    required = (
        "etc/omamobile-root-luks2",
        "etc/dropbear/dropbear_ed25519_host_key",
        "usr/local/sbin/cryptroot-unlock",
        "sbin/cryptsetup",
    )
    for name in required:
        if name not in names and not any(name == path for path in names):
            # Alpine can place cryptsetup in /usr/sbin instead of /sbin.
            if name != "sbin/cryptsetup" or "usr/sbin/cryptsetup" not in names:
                raise BuildError(f"--luks2 initramfs lacks /{name}")
    if cpio_file(ramdisk, "etc/omamobile-root-luks2").decode().strip() != "luks2":
        raise BuildError("invalid LUKS2 root marker")
    if not cpio_file(ramdisk, "etc/dropbear/dropbear_ed25519_host_key"):
        raise BuildError("persistent Dropbear host key is empty")
    init = cpio_file(ramdisk, "init").decode()
    if "/etc/dropbear/dropbear_ed25519_host_key" not in init or "dropbear -R" in init:
        raise BuildError("LUKS2 initramfs does not use the persistent Dropbear key")
    if "cryptroot-unlock" not in init:
        raise BuildError("LUKS2 initramfs does not wait for cryptroot-unlock")


def build_initramfs(rootfs, shared_init, key, output, work, root="none", *, luks2=False):
    stage = work / "rootfs"
    shutil.copytree(rootfs, stage, symlinks=True)
    (stage / "proc").mkdir(exist_ok=True)
    (stage / "sys").mkdir(exist_ok=True)
    (stage / "dev").mkdir(exist_ok=True)
    (stage / "run").mkdir(exist_ok=True)
    ssh_dir = stage / "root/.ssh"
    ssh_dir.mkdir(parents=True, exist_ok=True)
    shutil.copyfile(key, ssh_dir / "authorized_keys")
    ssh_dir.chmod(0o700)
    (ssh_dir / "authorized_keys").chmod(0o600)

    etc = stage / "etc"
    etc.mkdir(exist_ok=True)
    # No writable exception, NFS root or plan-5.8 register-write marker may
    # survive from the prepared root. omamobile.initramfs also blocks handoff.
    for name in ("omamobile-ufs-rw", "omamobile-ufs-rw-luns",
                 "omamobile-nfsroot", "omamobile-simplefb-trig",
                 "omamobile-bringup-probe", "omamobile-root-label",
                 "omamobile-root-mode"):
        remove_file(etc / name)
    if luks2:
        host_key = etc / "dropbear/dropbear_ed25519_host_key"
        if not host_key.is_file() or host_key.is_symlink():
            raise BuildError("--luks2 requires the phone-generated Dropbear host key in the initramfs root")
        if host_key.stat().st_mode & 0o077:
            raise BuildError("Dropbear host key must have no group/other permissions")
        if not any((stage / path).is_file() for path in
                   ("sbin/cryptsetup", "usr/sbin/cryptsetup", "usr/bin/cryptsetup")):
            raise BuildError("--luks2 requires cryptsetup in the prepared initramfs root")
        unlock_source = Path(__file__).resolve().parents[1] / \
            "device/instantnoodlep/initramfs/cryptroot-unlock"
        if not unlock_source.is_file():
            raise BuildError("cryptroot-unlock script is missing from the repository")
        unlock = stage / "usr/local/sbin/cryptroot-unlock"
        unlock.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(unlock_source, unlock)
        unlock.chmod(0o755)
        (etc / "omamobile-root-luks2").write_text("luks2\n")
    if root == "userdata":
        (etc / "omamobile-ufs-rw").write_text(ROOT_ALLOWLIST + "\n")
        (etc / "omamobile-root-label").write_text(ROOT_LABEL + "\n")
    (etc / "omamobile-compatible").write_text(COMPATIBLE[0] + "\n")
    (etc / "omamobile-usb-product").write_text(
        "OnePlus 8 Pro RAM-only probe\n" if root == "none"
        else "OnePlus 8 Pro tethered Omarchy Mobile\n")
    (stage / "init").write_text(patch_init(
        shared_init.read_text(), luks2=luks2,
        persistent_host_key=luks2 or
        (etc / "dropbear/dropbear_ed25519_host_key").is_file()))
    (stage / "init").chmod(0o755)
    pack_rootfs(stage, output)
    assert_allowlist(output, root)
    if luks2:
        assert_luksroot(output)


def fdt_get(dtb, node, prop, kind="s"):
    return run(["fdtget", "-t", kind, dtb, node, prop]).decode(
        "utf-8", "replace").strip()


def fdt_cells(dtb, node, prop):
    value = fdt_get(dtb, node, prop, "x")
    try:
        return [int(cell, 16) for cell in value.split()]
    except ValueError as error:
        raise BuildError(f"{prop} is not a list of 32-bit cells") from error


def require_identity(dtb):
    # fdtget -t s separates strings in one property with spaces, not newlines.
    compatible = fdt_get(dtb, "/", "compatible").split()
    if compatible != COMPATIBLE:
        raise BuildError(
            'root compatible must be exactly "oneplus,instantnoodlep","qcom,sm8250"')
    if fdt_cells(dtb, "/", "qcom,msm-id") != MSM_ID:
        raise BuildError(
            "qcom,msm-id must be exactly <0x164 0x10000>,<0x164 0x20001>")
    if fdt_cells(dtb, "/", "qcom,board-id") != BOARD_ID:
        raise BuildError("qcom,board-id must be exactly <0x08 0x00>,<0x00 0x00>")


def fdt_children(dtb, node):
    text = run(["fdtget", "-l", dtb, node]).decode("utf-8", "replace")
    return text.splitlines()


def remoteproc_nodes(dtb):
    found = []

    def walk(node):
        for child in fdt_children(dtb, node):
            path = ("" if node == "/" else node) + "/" + child
            if child.startswith("remoteproc@"):
                found.append(path)
            walk(path)

    walk("/")
    return found


def property_present(dtb, node, prop):
    result = subprocess.run(
        ["fdtget", "-t", "s", str(dtb), node, prop],
        stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if result.returncode not in (0, 1):
        raise BuildError(f"fdtget failed while reading {node}:{prop}")
    return result.returncode == 0


def verify_probe_dtb(dtb, boot, labels):
    require_identity(dtb)
    verify_overlay_sink(dtb, labels)
    if fdt_get(dtb, USB_NODE, "dr_mode") != "peripheral":
        raise BuildError("probe USB dr_mode is not peripheral")
    if property_present(dtb, USB_NODE, "usb-role-switch"):
        raise BuildError("probe USB role switch was not removed")
    remotes = remoteproc_nodes(dtb)
    for node in remotes:
        if fdt_get(dtb, node, "status") != "disabled":
            raise BuildError(f"remote processor was not disabled: {node}")
    want = "disabled" if boot == 1 else "okay"
    if fdt_get(dtb, UFS_NODE, "status") != want:
        raise BuildError(f"probe UFS host status is not {want}")
    for name, value in PON_MODES.items():
        if fdt_cells(dtb, PON_NODE, name) != [value]:
            raise BuildError(f"PON {name} is not {value:#x}")


def fdt_phandles(path):
    """Every phandle value in a flattened DTB (structure block walk)."""
    blob = Path(path).read_bytes()
    magic, _, off_struct, off_strings = struct.unpack_from(">4I", blob, 0)
    if magic != 0xD00DFEED:
        raise BuildError(f"not a flattened device tree: {path}")
    found, pos = set(), off_struct
    while True:
        (token,) = struct.unpack_from(">I", blob, pos)
        pos += 4
        if token == 1:  # FDT_BEGIN_NODE
            pos = (blob.index(b"\0", pos) + 4) & ~3
        elif token == 3:  # FDT_PROP
            length, name_off = struct.unpack_from(">II", blob, pos)
            pos += 8
            end = blob.index(b"\0", off_strings + name_off)
            name = blob[off_strings + name_off:end]
            if name in (b"phandle", b"linux,phandle") and length == 4:
                found.add(struct.unpack_from(">I", blob, pos)[0])
            pos = (pos + length + 3) & ~3
        elif token in (2, 4):  # FDT_END_NODE, FDT_NOP
            continue
        elif token == 9:  # FDT_END
            return found
        else:
            raise BuildError(f"bad FDT token {token} in {path}")


def overlay_labels(overlay):
    text = run(["fdtget", "-p", overlay, "/__fixups__"]).decode(
        "utf-8", "replace")
    labels = sorted(set(text.split()))
    if not labels:
        raise BuildError("--stock-overlay has no __fixups__ labels")
    for label in labels:
        if not label.replace("_", "").replace("-", "").isalnum():
            raise BuildError(f"unexpected overlay label: {label!r}")
    return labels


def add_overlay_sink(dtb, labels):
    for node in (SINK, SYMBOLS):
        if node.lstrip("/") in fdt_children(dtb, "/"):
            raise BuildError(f"input DTB already has {node}")
    run(["fdtput", "-t", "x", dtb, "/", "oplus,dtsi_no",
         *[f"{v:x}" for v in OPLUS_DTSI_NO]])
    run(["fdtput", "-t", "x", dtb, "/", "oplus,pcb_range",
         *[f"{v:x}" for v in OPLUS_PCB_RANGE]])
    run(["fdtput", "-c", dtb, SINK, SYMBOLS,
         *[f"{SINK}/{label}" for label in labels]])
    phandle = max(fdt_phandles(dtb), default=0) + 1
    for label in labels:
        node = f"{SINK}/{label}"
        run(["fdtput", "-t", "s", dtb, node, "status", "disabled"])
        run(["fdtput", "-t", "u", dtb, node, "phandle", str(phandle)])
        run(["fdtput", "-t", "s", dtb, SYMBOLS, label, node])
        phandle += 1


def verify_overlay_sink(dtb, labels):
    if fdt_cells(dtb, "/", "oplus,dtsi_no") != OPLUS_DTSI_NO:
        raise BuildError("probe oplus,dtsi_no is not 0x4d63")
    if fdt_cells(dtb, "/", "oplus,pcb_range") != OPLUS_PCB_RANGE:
        raise BuildError("probe oplus,pcb_range is not <0 0x38>")
    if property_present(dtb, SINK, "compatible"):
        raise BuildError(f"{SINK} must not have a compatible")
    for label in labels:
        node = f"{SINK}/{label}"
        if fdt_get(dtb, SYMBOLS, label) != node:
            raise BuildError(f"__symbols__ {label} does not point into {SINK}")
        if fdt_get(dtb, node, "status") != "disabled":
            raise BuildError(f"sink node is not disabled: {node}")
        fdt_cells(dtb, node, "phandle")
    symbols = run(["fdtget", "-p", dtb, SYMBOLS]).decode().split()
    if sorted(symbols) != labels:
        raise BuildError("__symbols__ holds labels the overlay does not need")


def check_overlay_applies(ufdt_apply, dtb, overlay, work):
    merged = work / "overlay-check.dtb"
    result = subprocess.run([str(ufdt_apply), str(dtb), str(overlay),
                             str(merged)], stdout=subprocess.PIPE,
                            stderr=subprocess.STDOUT)
    if result.returncode != 0 or not merged.is_file():
        raise BuildError("the stock overlay does not apply to the probe DTB:\n"
                         + result.stdout.decode("utf-8", "replace"))
    if merged.stat().st_size > DTB_LOAD_GAP:
        raise BuildError("post-overlay DTB exceeds ABL's 2 MiB DTB window")


def make_probe_dtb(source, output, boot, labels):
    require_identity(source)
    shutil.copyfile(source, output)
    run(["fdtput", "-t", "s", output, USB_NODE, "dr_mode", "peripheral"])
    if property_present(output, USB_NODE, "usb-role-switch"):
        run(["fdtput", "-d", output, USB_NODE, "usb-role-switch"])
    for node in remoteproc_nodes(output):
        run(["fdtput", "-t", "s", output, node, "status", "disabled"])
    run(["fdtput", "-t", "s", output, UFS_NODE, "status",
         "disabled" if boot == 1 else "okay"])
    for name, value in PON_MODES.items():
        run(["fdtput", "-t", "u", output, PON_NODE, name, str(value)])
    add_overlay_sink(output, labels)
    verify_probe_dtb(output, boot, labels)


def padded(size):
    return (size + PAGE - 1) // PAGE * PAGE


def kernel_image_size(path):
    """Payload bytes ABL will hold at the kernel load address.

    Q/ decompresses a gzip kernel at KernelLoadAddr into the region below
    the DTB slot (Q/BootLinux.c:652-671) and checks the decompressed image
    size against that region (Q/BootLinux.c:720-726), so the guard must
    measure the decompressed size, not the compressed file.
    """
    with path.open("rb") as stream:
        is_gzip = stream.read(2) == b"\x1f\x8b"
    if is_gzip:
        return len(run(["gzip", "-dc", path]))
    return path.stat().st_size


def check_image_sizes(kernel_size, ramdisk_size, dtb_size, kernel_image=None):
    if kernel_size <= 0 or ramdisk_size <= 0 or dtb_size <= 0:
        raise BuildError("kernel, initramfs and DTB must all be non-empty")
    if kernel_image is None:
        kernel_image = kernel_size
    if dtb_size > DTB_LOAD_GAP:
        raise BuildError(
            f"DTB is {dtb_size} bytes; ABL reserves only {DTB_LOAD_GAP} "
            "(2 MiB + one page) below the ramdisk for it "
            "(Q/BootLinux.c:207-209,400-405)")
    used = kernel_image + padded(ramdisk_size + PAGE) + DTB_LOAD_GAP
    if used > KERNEL_REGION:
        raise BuildError(
            f"decompressed kernel+initramfs+DTB gap is {used} bytes; the "
            f"reserved kernel region holds only {KERNEL_REGION} "
            "(Q/BootLinux.c:200-215; docs/research/abl-kernel-size.md)")
    image_size = PAGE + padded(kernel_size) + padded(ramdisk_size) + padded(dtb_size)
    if image_size > BOOT_IMAGE_MAX:
        raise BuildError(
            f"image is {image_size} bytes; the conservative {BOOT_IMAGE_MAX}-byte "
            f"cap is {SIZE_LIMIT_EVIDENCE}")
    return image_size


def pack_boot(mkbootimg, kernel, ramdisk, dtb, output, cmdline=CMDLINE):
    run([
        sys.executable, mkbootimg,
        "--header_version", HEADER_VERSION,
        "--base", BASE,
        "--kernel_offset", KERNEL_OFF,
        "--ramdisk_offset", RAMDISK_OFF,
        "--second_offset", SECOND_OFF,
        "--tags_offset", TAGS_OFF,
        "--dtb_offset", DTB_OFF,
        "--pagesize", PAGE,
        "--kernel", kernel,
        "--ramdisk", ramdisk,
        "--dtb", dtb,
        "--cmdline", cmdline,
        "--output", output,
    ])


def parse_boot_info(text):
    info = {}
    for line in text.splitlines():
        if ":" not in line:
            raise BuildError("unpack_bootimg returned an unreadable info line")
        key, value = line.split(":", 1)
        info[key.strip()] = value.strip()
    return info


def info_int(info, key):
    try:
        return int(info[key], 0)
    except (KeyError, ValueError) as error:
        raise BuildError(f"unpack_bootimg info has no numeric {key}") from error


def assert_boot_info(info, kernel_size, ramdisk_size, dtb_size, cmdline=CMDLINE):
    expected_ints = {
        "kernel_size": kernel_size,
        "kernel load address": BASE + KERNEL_OFF,
        "ramdisk size": ramdisk_size,
        "ramdisk load address": BASE + RAMDISK_OFF,
        "second bootloader size": 0,
        "second bootloader load address": BASE + SECOND_OFF,
        "kernel tags load address": BASE + TAGS_OFF,
        "page size": PAGE,
        "boot image header version": HEADER_VERSION,
        "recovery dtbo size": 0,
        "boot header size": 1660,
        "dtb size": dtb_size,
        "dtb address": BASE + DTB_OFF,
    }
    for key, expected in expected_ints.items():
        actual = info_int(info, key)
        if actual != expected:
            raise BuildError(
                f"read-back header disagrees for {key}: {actual}, expected {expected}")
    expected_strings = {
        "boot magic": "ANDROID!",
        "command line args": cmdline,
        "additional command line args": "",
        "recovery dtbo offset": "0x0000000000000000",
    }
    for key, expected in expected_strings.items():
        if info.get(key) != expected:
            raise BuildError(
                f"read-back header disagrees for {key}: {info.get(key)!r}")


def boot_cmdline(root, debug_shell=False):
    if root != "userdata":
        return CMDLINE
    return f"{ROOT_CMDLINE} {DEBUG_SHELL}" if debug_shell else ROOT_CMDLINE


def read_back_boot(boot, mkbootimg, kernel, ramdisk, dtb, work, root="none",
                   cmdline=CMDLINE):
    unpack = mkbootimg.with_name("unpack_bootimg.py")
    if not unpack.is_file():
        raise BuildError(f"missing sibling AOSP tool: {unpack}")
    out = work / "unpacked"
    text = run([
        sys.executable, unpack, "--boot_img", boot,
        "--out", out, "--format=info",
    ]).decode("utf-8", "replace")
    info = parse_boot_info(text)
    assert_boot_info(info, kernel.stat().st_size,
                     ramdisk.stat().st_size, dtb.stat().st_size,
                     cmdline)
    for name, source in (("kernel", kernel), ("ramdisk", ramdisk), ("dtb", dtb)):
        extracted = out / name
        if not extracted.is_file() or sha256(extracted) != sha256(source):
            raise BuildError(f"read-back {name} payload differs from the input")
    if boot.stat().st_size != check_image_sizes(
            kernel.stat().st_size, ramdisk.stat().st_size, dtb.stat().st_size,
            kernel_image_size(kernel)):
        raise BuildError("read-back image size disagrees with its page layout")
    assert_allowlist(out / "ramdisk", root)
    return info, out


def artifact_paths(out):
    stem = out.name[:-4] if out.name.endswith(".img") else out.name
    return {
        "boot": out,
        "dtb": out.with_name(stem + ".probe.dtb"),
        "ramdisk": out.with_name(stem + ".initramfs.cpio.gz"),
        "manifest": out.with_name(stem + ".manifest.json"),
        "sums": out.with_name(stem + ".SHA256SUMS"),
    }


def build(args):
    if args.boot not in (1, 2):
        raise BuildError("--boot must be 1 (UFS disabled) or 2 (UFS enabled)")
    if args.root not in ("none", "userdata"):
        raise BuildError("--root must be none or userdata")
    if args.root == "userdata" and args.boot != 2:
        raise BuildError("--root userdata needs --boot 2 (UFS enabled)")
    if args.luks2 and args.root != "userdata":
        raise BuildError("--luks2 needs --root userdata")
    if args.debug_shell and args.root != "userdata":
        raise BuildError("--debug-shell needs --root userdata")
    cmdline = boot_cmdline(args.root, args.debug_shell)
    paths = artifact_paths(args.out.absolute())
    for path in paths.values():
        if path.exists() or path.is_symlink():
            raise BuildError(f"output already exists: {path}; choose fresh output names")
    inputs = {
        "--kernel": args.kernel,
        "--dtb": args.dtb,
        "--ssh-key": args.ssh_key,
        "--mkbootimg": args.mkbootimg,
        "--stock-overlay": args.stock_overlay,
    }
    for name, path in inputs.items():
        if not path.is_file():
            raise BuildError(f"{name} must name a file: {path}")
    shared_init = args.omarchy_mobile / "initramfs/init"
    if not shared_init.is_file():
        raise BuildError(f"shared init not found: {shared_init}")
    if not args.initramfs_root.is_dir():
        raise BuildError("--initramfs-root must name a prepared root directory")
    needed = ["bin/busybox", "usr/sbin/dropbear"]
    if args.root == "userdata":
        needed += ["e2fsck", "dumpe2fs", "resize2fs"]
    if args.luks2:
        needed += ["cryptsetup"]
    for relative in needed:
        if "/" not in relative:
            if not any((args.initramfs_root / d / relative).exists()
                       for d in ("sbin", "usr/sbin", "bin", "usr/bin")):
                raise BuildError(f"initramfs root lacks {relative}")
        elif not (args.initramfs_root / relative).exists():
            raise BuildError(f"initramfs root lacks {relative}")
    for tool in ("bash", "cpio", "fdtget", "fdtput", "find", "gzip", "sort"):
        if shutil.which(tool) is None:
            raise BuildError(f"required host tool is missing: {tool}")
    validate_public_key(args.ssh_key)
    if args.ufdt_apply is not None and not os.access(args.ufdt_apply, os.X_OK):
        raise BuildError(f"--ufdt-apply is not executable: {args.ufdt_apply}")
    if args.luks2:
        host_key = args.initramfs_root / "etc/dropbear/dropbear_ed25519_host_key"
        if not host_key.is_file() or host_key.is_symlink():
            raise BuildError("--luks2 requires a phone-generated Dropbear host key in --initramfs-root")
        repository = Path(__file__).resolve().parents[1]
        if host_key.resolve().is_relative_to(repository):
            raise BuildError("private Dropbear host keys must stay outside the repository")
        if host_key.stat().st_mode & 0o077:
            raise BuildError("Dropbear host key must have no group/other permissions")
    labels = overlay_labels(args.stock_overlay)
    if args.mkbootimg.name != "mkbootimg.py":
        raise BuildError("--mkbootimg must name AOSP mkbootimg.py")

    paths["boot"].parent.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(
            prefix=".instantnoodlep-probe-", dir=paths["boot"].parent) as temp:
        work = Path(temp)
        staged = {name: work / path.name for name, path in paths.items()}
        make_probe_dtb(args.dtb, staged["dtb"], args.boot, labels)
        if args.ufdt_apply is not None:
            check_overlay_applies(args.ufdt_apply, staged["dtb"],
                                  args.stock_overlay, work)
        build_initramfs(args.initramfs_root, shared_init, args.ssh_key,
                        staged["ramdisk"], work, args.root, luks2=args.luks2)
        expected_size = check_image_sizes(
            args.kernel.stat().st_size, staged["ramdisk"].stat().st_size,
            staged["dtb"].stat().st_size, kernel_image_size(args.kernel))
        pack_boot(args.mkbootimg, args.kernel, staged["ramdisk"],
                  staged["dtb"], staged["boot"], cmdline)
        if staged["boot"].stat().st_size != expected_size:
            raise BuildError("mkbootimg output has an unexpected size")
        info, unpacked = read_back_boot(
            staged["boot"], args.mkbootimg, args.kernel,
            staged["ramdisk"], staged["dtb"], work, args.root, cmdline)
        verify_probe_dtb(unpacked / "dtb", args.boot, labels)
        if args.luks2:
            assert_luksroot(unpacked / "ramdisk")

        outputs = {}
        for name in ("boot", "dtb", "ramdisk"):
            outputs[name] = {
                "file": paths[name].name,
                "bytes": staged[name].stat().st_size,
                "sha256": sha256(staged[name]),
            }
        manifest = {
            "device": "instantnoodlep",
            "boot": args.boot,
            "root": args.root,
            "luks2": args.luks2,
            "debug_shell": args.debug_shell,
            "header": info,
            "boot_image_limit": {
                "bytes": BOOT_IMAGE_MAX,
                "evidence": SIZE_LIMIT_EVIDENCE,
            },
            "outputs": outputs,
            "shared_init_sha256": sha256(shared_init),
            "stock_overlay": {
                "sha256": sha256(args.stock_overlay),
                "labels": len(labels),
                "apply_checked": args.ufdt_apply is not None,
            },
            "mkbootimg_sha256": sha256(args.mkbootimg),
            "hardware_boot_tested": False,
        }
        staged["manifest"].write_text(
            json.dumps(manifest, indent=2, sort_keys=True) + "\n")
        sums = []
        for name in ("boot", "dtb", "ramdisk", "manifest"):
            sums.append(f"{sha256(staged[name])}  {paths[name].name}\n")
        staged["sums"].write_text("".join(sums))
        for name, final in paths.items():
            os.replace(staged[name], final)
    print(f"Built and read back {args.out} (RAM-only; no phone was accessed)",
          file=sys.stderr)
    print(f"fastboot -s <serial> boot {args.out}")


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--kernel", type=Path, required=True)
    parser.add_argument("--dtb", type=Path, required=True,
                        help="original instantnoodlep DTB; it is never modified")
    parser.add_argument("--ssh-key", type=Path, required=True,
                        help="one OpenSSH public key, never a private key")
    parser.add_argument("--mkbootimg", type=Path, required=True,
                        help="AOSP mkbootimg.py with sibling unpack_bootimg.py")
    parser.add_argument("--omarchy-mobile", type=Path, required=True,
                        help="upstream checkout containing initramfs/init")
    parser.add_argument("--initramfs-root", type=Path, required=True,
                        help="prepared offline aarch64 Alpine root directory")
    parser.add_argument("--stock-overlay", type=Path, required=True,
                        help="the stock dtbo entry ABL applies (entry 16)")
    parser.add_argument("--ufdt-apply", type=Path,
                        help="optional libufdt ufdt_apply_overlay for an offline apply check")
    parser.add_argument("--boot", type=int, required=True,
                        help="1 disables UFS; 2 enables UFS")
    parser.add_argument("--root", default="none",
                        help="none (RAM probe) or userdata: tethered M2, hand over "
                             "to Arch on userdata with an allowlist of userdata only")
    parser.add_argument("--luks2", action="store_true",
                        help="with --root userdata, unlock LUKS2 via cryptroot-unlock over USB SSH")
    parser.add_argument("--debug-shell", action="store_true",
                        help="with --root userdata: add " + DEBUG_SHELL)
    parser.add_argument("--out", type=Path, required=True,
                        help="new boot.img path; sibling artifacts derive from its name")
    args = parser.parse_args(argv)
    try:
        build(args)
    except (BuildError, OSError, subprocess.SubprocessError) as error:
        print(f"error: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
