#!/bin/bash
# SPDX-License-Identifier: MIT
# Host-side package self-checks; no ARM package build or phone access.
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."

scripts=(
  PKGBUILD
  build
  install
  omamobile-device-instantnoodlep.install
  bin/omamobile-bt-public-addr
  bin/omamobile-instantnoodlep-mobile-profile
  bin/omamobile-instantnoodlep-app-launcher
  bin/omamobile-instantnoodlep-scaling
  ../../tools/instantnoodlep-pm-sample
  test/pm-sample.sh
  test/all
  test/bt-public-addr
  test/mobile-profile.sh
  test/scaling.sh
  test/udev
)
bash -n "${scripts[@]}"
shellcheck "${scripts[@]}"
srcinfo=$(mktemp)
trap 'rm -f "$srcinfo"' EXIT
makepkg --printsrcinfo > "$srcinfo"
grep -q "^pkgbase = omamobile-device-instantnoodlep$" "$srcinfo"
./test/bt-public-addr
./test/mobile-profile.sh
./test/scaling.sh
./test/pm-sample.sh
./test/udev
./test/udev --selftest

stage=$(mktemp -d)
trap 'rm -rf "$stage" "$srcinfo"' EXIT
./install "$stage"
test -f "$stage/usr/share/omamobile/device.conf"
test -f "$stage/usr/share/omamobile/firmware.map"
cmp -s firmware.map ../../device/instantnoodlep/firmware.map
test -f "$stage/usr/share/uwsm/env.d/90-omamobile-instantnoodlep-graphics"
test -f "$stage/usr/lib/environment.d/50-omamobile-back.conf"
test -f "$stage/usr/share/omamobile/device-ui.conf"
grep -qx "OMAMOBILE_BACK_EDGE_INSET=0" environment.d/50-omamobile-back.conf
test -f "$stage/usr/lib/environment.d/40-omamobile-instantnoodlep-sleep.conf"
test -f "$stage/usr/lib/systemd/sleep.conf.d/40-omamobile-instantnoodlep.conf"
grep -qx 'OMAMOBILE_SLEEP_AFTER_OFF=30' environment.d/40-omamobile-instantnoodlep-sleep.conf
grep -qx 'MemorySleepMode=s2idle' systemd/sleep.conf.d/40-omamobile-instantnoodlep.conf
test ! -e "$stage/usr/share/omamobile/auto-sleep-default"
test -f "$stage/usr/lib/systemd/system/omamobile-bt-public-addr@.service"
test -f "$stage/usr/share/omamobile/instantnoodlep-mobile-profile/instantnoodlep.conf"
test -f "$stage/usr/share/omamobile/instantnoodlep-mobile-profile/apps.conf"
test -x "$stage/usr/bin/omamobile-instantnoodlep-mobile-profile"
test -x "$stage/usr/bin/omamobile-instantnoodlep-app-launcher"
test -f "$stage/usr/lib/systemd/user/omamobile-instantnoodlep-mobile-profile.service"
test -L "$stage/usr/lib/systemd/user/graphical-session-pre.target.wants/omamobile-instantnoodlep-mobile-profile.service"
test "$(readlink "$stage/usr/lib/systemd/user/graphical-session-pre.target.wants/omamobile-instantnoodlep-mobile-profile.service")" = ../omamobile-instantnoodlep-mobile-profile.service
test -f "$stage/usr/share/omamobile/instantnoodlep-scaling/apps.tsv"
test -f "$stage/usr/share/omamobile/instantnoodlep-scaling/windowrules.lua"
test -x "$stage/usr/bin/omamobile-instantnoodlep-scaling"
test -f "$stage/usr/lib/systemd/user/omamobile-instantnoodlep-scaling.service"
test -L "$stage/usr/lib/systemd/user/graphical-session-pre.target.wants/omamobile-instantnoodlep-scaling.service"
test "$(readlink "$stage/usr/lib/systemd/user/graphical-session-pre.target.wants/omamobile-instantnoodlep-scaling.service")" = ../omamobile-instantnoodlep-scaling.service
if grep -R -n -E 'GDK_SCALE|QT_SCALE_FACTOR' "$stage/usr/lib/environment.d" "$stage/usr/share/uwsm/env.d"; then
  echo "toolkit scale variables must stay out of global environment files" >&2
  exit 1
fi
for rule in udev/*.rules; do
  test -f "$stage/usr/lib/udev/rules.d/${rule##*/}"
done
test -f "$stage/usr/lib/sysusers.d/omamobile.conf"
test -L "$stage/etc/systemd/system/systemd-firstboot.service"
test "$(readlink "$stage/etc/systemd/system/systemd-firstboot.service")" = /dev/null
test -L "$stage/etc/systemd/system/systemd-vconsole-setup.service"
test "$(readlink "$stage/etc/systemd/system/systemd-vconsole-setup.service")" = /dev/null
# Skip ./pkg: makepkg creates it mode 0111 during check(), and find must not
# trip over it (set -e would fail the whole check).
firmware_blob=$(find . -path ./pkg -prune -o -type f \( -name '*.mbn' -o -name '*.mdt' -o -name '*.bin' -o -name '*.tlv' \) -print -quit)
test -z "$firmware_blob"

printf '%s\n' 'all device package self-checks passed'
