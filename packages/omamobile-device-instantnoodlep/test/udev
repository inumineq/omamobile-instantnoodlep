#!/bin/bash
# SPDX-License-Identifier: MIT
# Host-side udev/sysusers baseline checks for omamobile-device-instantnoodlep
# (issue #189). Parses every udev/*.rules for syntax, target group/mode,
# duplicate match keys, and SYSTEMD_WANTS/TAG targets that exist in the
# package; validates sysusers.d/*.conf. No phone, no device nodes, runs on
# x86. Usage:
#   test/udev [PACKAGE_DIR]   check that package (default: this script's own)
#   test/udev --selftest      positive fixture must pass, negative ones fail
set -euo pipefail

MODE_RE='^[0-7]{3,4}$'
TOKEN_RE='^([A-Za-z_][A-Za-z0-9_]*)([{][^}]*[}])?(==|!=|:=|[+]=|=)"([^"]*)"$'
BUILTIN_TAGS=' systemd uaccess '

die() { printf 'test/udev: FAIL %s\n' "$*" >&2; exit 1; }

PKG=''
PKG_GROUPS=''
PKG_USERS=''

# --- sysusers.d -----------------------------------------------------------

check_sysusers() { # $1 = package dir
  local pkg=$1 f line type name id
  local -a confs=()
  [[ -d $pkg/sysusers.d ]] || die "no sysusers.d directory in $pkg"
  mapfile -t confs < <(find "$pkg/sysusers.d" -maxdepth 1 -type f -name '*.conf' | sort)
  [[ ${#confs[@]} -gt 0 ]] || die "no *.conf in $pkg/sysusers.d"
  for f in "${confs[@]}"; do
    while IFS= read -r line || [[ -n $line ]]; do
      if [[ $line =~ ^[[:space:]]*(#|$) ]]; then continue; fi
      read -r type name id _ <<< "$line"
      case $type in
        u|g|m|r) ;;
        *) die "$f: bad sysusers type '$type' in: $line" ;;
      esac
      [[ $name =~ ^[a-z_][a-z0-9_-]*$ ]] || die "$f: bad sysusers name '$name' in: $line"
      if [[ $id != '-' && ! $id =~ ^[0-9]+$ ]]; then
        die "$f: bad sysusers id '$id' in: $line"
      fi
    done < "$f"
  done
}

known_group() { # $1 = group name
  local g=$1 f
  if [[ -n $PKG_GROUPS ]] && printf '%s\n' "$PKG_GROUPS" | grep -qx -- "$g"; then return 0; fi
  for f in /usr/lib/sysusers.d/*.conf /etc/sysusers.d/*.conf; do
    if [[ -r $f ]] && awk -v g="$g" '$1=="g" && $2==g {found=1} END {exit !found}' "$f"; then
      return 0
    fi
  done
  if [[ -r /etc/group ]] && awk -F: -v g="$g" '$1==g {found=1} END {exit !found}' /etc/group; then
    return 0
  fi
  return 1
}

known_user() { # $1 = user name
  local u=$1
  if [[ -n $PKG_USERS ]] && printf '%s\n' "$PKG_USERS" | grep -qx -- "$u"; then return 0; fi
  if [[ -r /etc/passwd ]] && awk -F: -v u="$u" '$1==u {found=1} END {exit !found}' /etc/passwd; then
    return 0
  fi
  return 1
}

# --- unit lookup ----------------------------------------------------------

unit_shipped() { # $1 = unit name, may contain % specifiers and an instance
  local u=$1 f base
  u=${u//%[a-zA-Z]/x}
  for f in "$PKG/systemd/$u" "$PKG/systemd/user/$u" "/usr/lib/systemd/system/$u"; do
    if [[ -f $f ]]; then return 0; fi
  done
  if [[ $u == *@* ]]; then
    base=${u%@*}
    for f in "$PKG/systemd/$base@.service" "$PKG/systemd/user/$base@.service" "/usr/lib/systemd/system/$base@.service"; do
      if [[ -f $f ]]; then return 0; fi
    done
  fi
  return 1
}

# --- rule parsing ---------------------------------------------------------

split_tokens() { # $1 = rule line; prints one comma-separated token per line
  local line=$1 out='' c i inq=0
  for (( i=0; i<${#line}; i++ )); do
    c=${line:i:1}
    if [[ $c == '"' ]]; then inq=$(( 1 - inq )); fi
    if [[ $c == ',' && $inq == 0 ]]; then
      printf '%s\n' "$out"
      out=''
    else
      out+=$c
    fi
  done
  if [[ -n $out ]]; then printf '%s\n' "$out"; fi
}

check_rule_file() { # $1 = rule file path
  local file=$1 line lineno=0 tok key op val first base
  local seen_match='' seen_assign='' has_wants=0 has_systemd_tag=0
  local -a labels=() gotos=() units=()
  [[ -s $file ]] || die "$file: empty rule file"
  while IFS= read -r line || [[ -n $line ]]; do
    lineno=$(( lineno + 1 ))
    line=${line#"${line%%[![:space:]]*}"}
    line=${line%"${line##*[![:space:]]}"}
    if [[ -z $line || $line == \#* ]]; then continue; fi
    seen_match='' seen_assign='' has_wants=0 has_systemd_tag=0
    while IFS= read -r tok; do
      [[ -n $tok ]] || continue
      tok=${tok#"${tok%%[![:space:]]*}"}
      tok=${tok%"${tok##*[![:space:]]}"}
      [[ -n $tok ]] || continue
      if [[ ! $tok =~ $TOKEN_RE ]]; then
        die "$file:$lineno: syntax: cannot parse token: $tok"
      fi
      key=${BASH_REMATCH[1]}${BASH_REMATCH[2]}
      op=${BASH_REMATCH[3]}
      val=${BASH_REMATCH[4]}
      case $op in
        ==|!=)
          if [[ $seen_match == *" $key "* ]]; then
            die "$file:$lineno: duplicate match key '$key'"
          fi
          seen_match+=" $key "
          ;;
        =|:=|[+]=)
          if [[ $seen_assign == *" $key "* ]]; then
            die "$file:$lineno: duplicate assignment key '$key'"
          fi
          seen_assign+=" $key "
          ;;
      esac
      case $key in
        'GROUP')
          known_group "$val" || die "$file:$lineno: GROUP=\"$val\" is neither declared in sysusers.d/*.conf nor a base Arch group"
          ;;
        'OWNER')
          known_user "$val" || die "$file:$lineno: OWNER=\"$val\" is not a known user"
          ;;
        'MODE')
          if [[ ! $val =~ $MODE_RE ]]; then
            die "$file:$lineno: invalid MODE=\"$val\" (want 3-4 octal digits)"
          fi
          ;;
        'TAG')
          if [[ $BUILTIN_TAGS != *" $val "* ]]; then
            die "$file:$lineno: TAG+=\"$val\" is not a builtin tag (allowed:$BUILTIN_TAGS)"
          fi
          if [[ $val == systemd ]]; then has_systemd_tag=1; fi
          ;;
        'ENV{SYSTEMD_WANTS}'|'ENV{SYSTEMD_USER_WANTS}')
          has_wants=1
          read -ra units <<< "$val"
          for u in "${units[@]}"; do
            unit_shipped "$u" || die "$file:$lineno: $key target '$u' is not shipped in the package (systemd/) nor a base system unit"
          done
          ;;
        'GOTO') gotos+=("$val") ;;
        'LABEL') labels+=("$val") ;;
        RUN*)
          first=${val%% *}
          if [[ $first == /usr/bin/omamobile* ]]; then
            base=${first##*/}
            [[ -f $PKG/bin/$base ]] || die "$file:$lineno: RUN target '$first' is not shipped in bin/"
          fi
          ;;
      esac
    done < <(split_tokens "$line")
    if (( has_wants )) && (( ! has_systemd_tag )); then
      die "$file:$lineno: SYSTEMD_WANTS without TAG+=\"systemd\" in the same rule (wants are ignored on untagged devices)"
    fi
  done < "$file"
  local g l found
  for g in "${gotos[@]}"; do
    found=0
    for l in "${labels[@]}"; do
      if [[ $l == "$g" ]]; then found=1; break; fi
    done
    if (( ! found )); then die "$file: GOTO=\"$g\" has no LABEL in the same file"; fi
  done
}

# --- package check --------------------------------------------------------

check_package() { # $1 = package dir
  local pkg r base
  local -a rules=()
  PKG=$(cd "$1" && pwd)
  PKG_GROUPS=$(awk '$1=="g" {print $2}' "$PKG"/sysusers.d/*.conf 2>/dev/null || true)
  PKG_USERS=$(awk '$1=="u" {print $2}' "$PKG"/sysusers.d/*.conf 2>/dev/null || true)
  check_sysusers "$PKG"
  [[ -d $PKG/udev ]] || die "no udev directory in $PKG"
  mapfile -t rules < <(find "$PKG/udev" -maxdepth 1 -type f -name '*.rules' | sort)
  [[ ${#rules[@]} -gt 0 ]] || die "no udev/*.rules in $PKG"
  for r in "${rules[@]}"; do
    base=${r##*/}
    check_rule_file "$r"
    grep -qF -- "$base" "$PKG/install" || die "$base is not staged by install"
    grep -qF -- "$base" "$PKG/udev/README.md" || die "$base is not covered in udev/README.md"
  done
  printf 'test/udev: %d rule file(s) OK in %s\n' "${#rules[@]}" "$PKG"
}

# --- selftest -------------------------------------------------------------

expect_fail() { # $1 = mini package, $2 = case name, $3 = expected reason, $4 = rule line
  local mini=$1 name=$2 reason=$3 line=$4 out rc
  printf '%s\n' "$line" > "$mini/udev/99-$name.rules"
  set +e
  out=$( (check_package "$mini") 2>&1 )
  rc=$?
  set -e
  rm -f "$mini/udev/99-$name.rules"
  if [[ $rc -eq 0 ]]; then
    printf 'test/udev: selftest FAIL: case "%s" was accepted\n' "$name" >&2
    return 1
  fi
  if [[ $out != *"$reason"* ]]; then
    printf 'test/udev: selftest FAIL: case "%s" failed without "%s":\n%s\n' "$name" "$reason" "$out" >&2
    return 1
  fi
  printf 'test/udev: selftest: "%s" rejected as expected (%s)\n' "$name" "$reason"
}

selftest() {
  local tmp mini out
  tmp=$(mktemp -d)
  mini=$tmp/pkg
  mkdir -p "$mini/udev" "$mini/sysusers.d" "$mini/systemd" "$mini/bin"
  printf '# SPDX-License-Identifier: MIT\ng camera - - - -\n' > "$mini/sysusers.d/omamobile.conf"
  # shellcheck disable=SC2016 # the fixture install script must keep "$1" literal
  printf '#!/bin/bash\ninstall -Dm644 udev/70-good.rules "$1/usr/lib/udev/rules.d/70-good.rules"\n' > "$mini/install"
  printf '<!-- SPDX-License-Identifier: MIT -->\nThe table lists 70-good.rules.\n' > "$mini/udev/README.md"
  printf '# SPDX-License-Identifier: MIT\n[Unit]\nDescription=fixture\n' > "$mini/systemd/omamobile-fixture@.service"
  cat > "$mini/udev/70-good.rules" <<'EOF'
# SPDX-License-Identifier: MIT
ACTION=="add", SUBSYSTEM=="bluetooth", KERNEL=="hci[0-9]*", DRIVERS=="hci_uart_qca", TAG+="systemd", ENV{SYSTEMD_WANTS}+="omamobile-fixture@%k.service"
SUBSYSTEM=="video4linux", KERNEL=="video[0-9]*", GROUP="camera", MODE="0660", TAG+="uaccess"
EOF
  if ! out=$( (check_package "$mini") 2>&1 ); then
    printf 'test/udev: selftest FAIL: good fixture rejected:\n%s\n' "$out" >&2
    rm -rf "$tmp"
    return 1
  fi
  printf 'test/udev: selftest: good fixture accepted (%s)\n' "$out"
  expect_fail "$mini" dup 'duplicate match key' \
    'ACTION=="add", SUBSYSTEM=="block", KERNEL=="sda", KERNEL=="sdb"' || { rm -rf "$tmp"; return 1; }
  expect_fail "$mini" syntax 'syntax' \
    'ACTION=="add", SUBSYSTEM=="block' || { rm -rf "$tmp"; return 1; }
  expect_fail "$mini" group 'neither declared in sysusers.d' \
    'SUBSYSTEM=="video4linux", KERNEL=="video[0-9]*", GROUP="nosuchgroup", MODE="0660"' || { rm -rf "$tmp"; return 1; }
  expect_fail "$mini" mode 'invalid MODE' \
    'SUBSYSTEM=="block", KERNEL=="sda", MODE="999"' || { rm -rf "$tmp"; return 1; }
  expect_fail "$mini" wants 'not shipped in the package' \
    'ACTION=="add", TAG+="systemd", ENV{SYSTEMD_WANTS}+="omamobile-not-shipped@%k.service"' || { rm -rf "$tmp"; return 1; }
  expect_fail "$mini" wants-no-tag 'without TAG+="systemd"' \
    'ACTION=="add", ENV{SYSTEMD_WANTS}+="omamobile-fixture@%k.service"' || { rm -rf "$tmp"; return 1; }
  expect_fail "$mini" tag 'not a builtin tag' \
    'ACTION=="add", TAG+="bogus"' || { rm -rf "$tmp"; return 1; }
  expect_fail "$mini" goto 'no LABEL' \
    'ACTION=="add", GOTO="missing_end"' || { rm -rf "$tmp"; return 1; }
  expect_fail "$mini" run 'not shipped in bin' \
    'ACTION=="add", RUN+="/usr/bin/omamobile-not-shipped --go"' || { rm -rf "$tmp"; return 1; }
  # bad sysusers line must fail too
  printf 'x camera - - - -\n' > "$mini/sysusers.d/omamobile.conf"
  set +e
  out=$( (check_package "$mini") 2>&1 )
  rc=$?
  set -e
  if [[ $rc -eq 0 || $out != *"bad sysusers type"* ]]; then
    printf 'test/udev: selftest FAIL: bad sysusers line not rejected:\n%s\n' "$out" >&2
    rm -rf "$tmp"
    return 1
  fi
  printf 'test/udev: selftest: "sysusers" rejected as expected (bad sysusers type)\n'
  rm -rf "$tmp"
  printf 'test/udev: selftest passed\n'
}

main() {
  case ${1:-} in
    --selftest) selftest ;;
    '') check_package "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)" ;;
    *) check_package "$1" ;;
  esac
}
main "$@"
